{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "data": {
    "name": "inputs"
  },
  "transform": [
    {
      "window": [
        {
          "op": "row_number",
          "as": "curio_row"
        }
      ]
    },
    {
      "calculate": "'[!! combine !!]' === 'None' ? datum.curio_row : 0",
      "as": "curio_group"
    },
    {
      "aggregate": [
        {
          "op": "mean",
          "field": "[!! y !!]",
          "as": "curio_mean"
        },
        {
          "op": "sum",
          "field": "[!! y !!]",
          "as": "curio_sum"
        },
        {
          "op": "median",
          "field": "[!! y !!]",
          "as": "curio_median"
        },
        {
          "op": "min",
          "field": "[!! y !!]",
          "as": "curio_min"
        },
        {
          "op": "max",
          "field": "[!! y !!]",
          "as": "curio_max"
        },
        {
          "op": "count",
          "as": "curio_count"
        }
      ],
      "groupby": [
        "scenario_name",
        "[!! x !!]",
        "curio_group"
      ]
    },
    {
      "calculate": "({'Mean': datum.curio_mean, 'Sum': datum.curio_sum, 'Median': datum.curio_median, 'Minimum': datum.curio_min, 'Maximum': datum.curio_max, 'Count of rows': datum.curio_count, 'None': datum.curio_max})['[!! combine !!]']",
      "as": "curio_value"
    }
  ],
  "mark": {
    "type": "bar",
    "tooltip": true
  },
  "encoding": {
    "x": {
      "field": "[!! x !!]",
      "type": "nominal",
      "title": "[!! x_title !!]"
    },
    "xOffset": {
      "field": "scenario_name",
      "type": "nominal"
    },
    "y": {
      "field": "curio_value",
      "type": "quantitative",
      "title": "[!! y_title !!]"
    },
    "color": {
      "field": "scenario_name",
      "type": "nominal",
      "title": "Scenario"
    }
  }
}
