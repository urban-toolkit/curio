{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "data": {
    "name": "inputs"
  },
  "transform": [
    {
      "window": [
        {
          "op": "row_number",
          "as": "curio_row"
        }
      ]
    },
    {
      "calculate": "'[!! combine !!]' === 'None' ? datum.curio_row : 0",
      "as": "curio_group"
    },
    {
      "aggregate": [
        {
          "op": "mean",
          "field": "[!! value !!]",
          "as": "curio_mean"
        },
        {
          "op": "sum",
          "field": "[!! value !!]",
          "as": "curio_sum"
        },
        {
          "op": "median",
          "field": "[!! value !!]",
          "as": "curio_median"
        },
        {
          "op": "min",
          "field": "[!! value !!]",
          "as": "curio_min"
        },
        {
          "op": "max",
          "field": "[!! value !!]",
          "as": "curio_max"
        },
        {
          "op": "count",
          "as": "curio_count"
        }
      ],
      "groupby": [
        "scenario_name",
        "curio_group"
      ]
    },
    {
      "calculate": "({'Mean': datum.curio_mean, 'Sum': datum.curio_sum, 'Median': datum.curio_median, 'Minimum': datum.curio_min, 'Maximum': datum.curio_max, 'Count of rows': datum.curio_count, 'None': datum.curio_max})['[!! combine !!]']",
      "as": "curio_value"
    }
  ],
  "encoding": {
    "theta": {
      "field": "curio_value",
      "type": "quantitative",
      "title": "[!! value_title !!]",
      "stack": true
    },
    "color": {
      "field": "scenario_name",
      "type": "nominal",
      "title": "Scenario"
    }
  },
  "layer": [
    {
      "mark": {
        "type": "arc",
        "tooltip": true
      }
    },
    {
      "mark": {
        "type": "text",
        "radius": {
          "expr": "min(width, height) / 3"
        },
        "fontWeight": "bold",
        "fill": "white"
      },
      "encoding": {
        "text": {
          "field": "curio_value",
          "type": "quantitative",
          "title": "[!! value_title !!]",
          "format": ",.3~f"
        }
      }
    }
  ]
}
