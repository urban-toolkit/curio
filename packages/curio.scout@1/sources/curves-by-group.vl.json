{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "data": {
    "name": "inputs"
  },
  "mark": {
    "type": "line",
    "strokeWidth": 2,
    "tooltip": true
  },
  "encoding": {
    "x": {
      "field": "[!! x !!]",
      "type": "quantitative",
      "title": "[!! x_title !!]"
    },
    "y": {
      "field": "[!! y !!]",
      "type": "quantitative",
      "title": "[!! y_title !!]",
      "axis": {
        "labelExpr": "'[!! y_format !!]' === '' ? datum.label : format(datum.value, '[!! y_format !!]')"
      }
    },
    "color": {
      "field": "scenario_name",
      "type": "nominal",
      "title": "Scenario",
      "scale": [!! scenario colors !!]
    },
    "strokeDash": {
      "field": "[!! group !!]",
      "type": "nominal",
      "title": "[!! group_title !!]",
      "sort": null
    }
  }
}
