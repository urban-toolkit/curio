{
  "id": "source.curio.example-storage",
  "name": "Example storage",
  "version": "1.0.0",
  "compatibility": { "major": 1 },
  "description": "A small folder that ships with Curio, holding one example of each way a storage source can be organized: sensor readings split by subfolder, a shapefile, orthorectified tiles by year, dashcam frames, geotagged photos with a video, and noise recordings. Every file is synthetic.",
  "publisher": "Curio",
  "homepage": null,
  "license": "CC0-1.0",
  "tags": ["example", "storage", "chicago"],
  "provider": { "type": "folder", "root": "docs/examples/data/storage" },
  "auth": { "mode": "public" },
  "resources": [
    {
      "id": "air-quality",
      "name": "Air quality readings",
      "description": "Six-hourly readings, one CSV per sensor per day.",
      "kind": "table",
      "format": "csv",
      "path": "air-quality/{sensor}/{day:date}.csv"
    },
    {
      "id": "stations",
      "name": "Sensor stations",
      "kind": "table",
      "format": "csv",
      "path": "air-quality/stations.csv"
    },
    {
      "id": "roads",
      "name": "Roads",
      "kind": "table",
      "format": "shp",
      "path": "city/roads.shp"
    },
    {
      "id": "parks",
      "name": "Parks",
      "kind": "table",
      "format": "geojson",
      "path": "city/parks.geojson"
    },
    {
      "id": "orthos",
      "name": "Drone orthoimagery",
      "description": "RGB tiles at 50 cm, one campaign per year.",
      "kind": "rasters",
      "path": "orthos/{year:int}/{tile}.tif"
    },
    {
      "id": "dashcam",
      "name": "Dashcam frames",
      "kind": "frames",
      "path": "dashcam/{date:date}/{sequence}_{frame:int}.jpg",
      "fps": 10,
      "metadata": { "path": "dashcam/{date:date}/telemetry.csv", "on": "file_name" }
    },
    {
      "id": "survey",
      "name": "Street survey",
      "description": "Geotagged photos and a short clip.",
      "kind": "media",
      "path": "survey/{year:int}/**/*"
    },
    {
      "id": "noise",
      "name": "Noise recordings",
      "kind": "audio",
      "path": "noise/{sensor}/{recorded:%Y%m%d_%H%M%S}.wav",
      "time": "recorded"
    }
  ],
  "createdAt": "2026-09-27T00:00:00Z",
  "updatedAt": "2026-09-27T00:00:00Z"
}
