{
  "id": "agent.dataflow-builder",
  "name": "Dataflow Builder",
  "category": "canvas",
  "version": "1.0.0",
  "purpose": "Plan a connected dataflow from a goal as one reviewable proposal; solve unresolved nodes through delegated specialists. Never mutates without review.",
  "catalog": {
    "listed": true,
    "order": 6
  },
  "workedExamples": true,
  "roles": [
    "orchestration"
  ],
  "capabilities": [
    {
      "id": "dataflow.orchestrate",
      "contractVersion": "1"
    }
  ],
  "prompts": {
    "system": {
      "path": "curio:default_preamble.md",
      "variables": []
    },
    "instruction": {
      "path": "prompts/orchestration_instruction.md",
      "variables": []
    }
  },
  "compatibleTargets": [
    {
      "kind": "canvas",
      "requires": []
    }
  ],
  "inputs": {
    "reads": [
      "mission",
      "graphContext",
      "installedTemplates"
    ],
    "requiredConfig": []
  },
  "tools": [
    {
      "id": "dataflow.read"
    },
    {
      "id": "dataflow.plan.write"
    },
    {
      "id": "node.runtime.read"
    },
    {
      "id": "node.create"
    },
    {
      "id": "examples.read"
    }
  ],
  "runtime": {
    "execution": "background",
    "reviewPolicy": "review-before-apply"
  },
  "providerRequirements": {
    "capabilities": [
      "structured-output"
    ]
  },
  "provenance": {
    "publisher": "curio",
    "license": "MIT",
    "trust": "built-in"
  },
  "delegatesTo": [
    "agent.dataset-finder",
    "agent.node-builder",
    {
      "id": "agent.dataflow-planner",
      "capabilities": [
        "workflow.plan.create",
        "execution.followup.plan",
        "workflow.plan.refresh",
        "workflow.coherence.validate"
      ]
    },
    {
      "id": "agent.dataflow-reader",
      "capabilities": [
        "workflow.suggest",
        "dataflow.explain"
      ]
    },
    "agent.generated-content-evaluator",
    {
      "id": "agent.researcher",
      "capabilities": [
        "research.notes.compose",
        "research.verify"
      ]
    }
  ],
  "requiresAgents": [
    "agent.dataset-finder",
    "agent.node-builder"
  ]
}
