{
  "id": "agent.curio.researcher",
  "name": "Researcher",
  "category": "node",
  "version": "1.0.0",
  "purpose": "Talk about a node or the whole dataflow: it explains them, diagnoses errors and helps you define what to build. It also answers questions from the web as notes on the canvas, and checks facts such as dataset ids and endpoints.",
  "catalog": {
    "listed": true,
    "order": 1
  },
  "skills": [
    "node-functions",
    "catalogs",
    "widgets",
    "selection-chips",
    "autark",
    "vega-lite-starter",
    "autark-starter",
    "vega-lite-maps",
    "interaction-edges",
    "map-edits",
    "scenarios",
    "dashboards",
    "provenance"
  ],
  "roles": [
    "authoring"
  ],
  "capabilities": [
    {
      "id": "research.notes.compose",
      "contractVersion": "1",
      "instruction": "research.notes.compose",
      "reads": [
        "question",
        "searchResults",
        "notesTemplates"
      ],
      "requiredConfig": [],
      "label": "Notes from search results"
    },
    {
      "id": "research.verify",
      "contractVersion": "1",
      "instruction": "research.verify",
      "reads": [
        "mission",
        "nodeContext"
      ],
