    "research.notes.compose": {
      "path": "prompts/researcher_notes_instruction.md",
      "variables": []
    },
    "research.verify": {
      "path": "prompts/research_instruction.md",
      "variables": []
    }
  },
  "compatibleTargets": [
    {
