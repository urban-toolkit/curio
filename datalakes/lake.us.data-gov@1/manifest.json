  "auth": { "mode": "public" },
  "capabilities": {
    "search": true,
    "describe": true,
    "download": true,
    "formats": ["csv", "geojson", "json", "parquet"],
    "maxDownloadBytes": 67108864,
    "allowOffBaseDistributions": true
  },
  "limits": { "requestsPerMinute": 20 },
