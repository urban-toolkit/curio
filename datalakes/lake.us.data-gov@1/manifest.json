{
  "id": "lake.us.data-gov",
  "name": "Data.gov",
  "version": "1.0.0",
  "compatibility": { "major": 1 },
  "description": "The United States federal open data catalog, aggregating datasets from federal, state and local agencies.",
  "publisher": "U.S. General Services Administration",
