# Diagnostic dumps written next to expected screenshots when an e2e test
# captures browser console / WebGPU / autk error info. Useful for
# debugging a failing run, not something to track in git.
docs/examples/dataflows/expected_outputs/*_browser_log.txt
docs/examples/dataflows/expected_outputs/*_actual.png

# Per-session port overrides (see the file for why the defaults collide).
.curio-ports.sh

# The E2E broken-library fixture publishes this into the shared catalog and
# unpublishes it in teardown (test_broken_library_e2e.py). A run killed
# mid-test leaves it behind; it is never a real catalog package, so it must
# never reach a commit.
/packages/curio.e2ebroken@1/
