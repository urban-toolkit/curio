            "geojsonObject": { "type": "FeatureCollection", "features": [
              { "type": "Feature", "properties": { "kind": "collection" },
                "geometry": { "type": "GeometryCollection", "bbox": [-87.64, 41.88, -87.61, 41.89], "geometries": [
                  { "type": "Polygon", "coordinates": [[[-87.64, 41.88], [-87.63, 41.88], [-87.63, 41.89], [-87.64, 41.89], [-87.64, 41.88]]] },
                  { "type": "Polygon", "coordinates": [[[-87.62, 41.88], [-87.61, 41.88], [-87.61, 41.89], [-87.62, 41.89], [-87.62, 41.88]]] }
