          {
            "type": "geojson", "outputTableName": "polygon", "coordinateFormat": "EPSG:4326",
            "geojsonObject": { "type": "FeatureCollection", "features": [
              { "type": "Feature", "properties": { "kind": "polygon" },
                "geometry": { "type": "Polygon", "bbox": [-87.64, 41.88, -87.63, 41.89],
                  "coordinates": [[[-87.64, 41.88], [-87.63, 41.88], [-87.63, 41.89], [-87.64, 41.89], [-87.64, 41.88]]] } }
            ] }
          },
          {
            "type": "geojson", "outputTableName": "multipolygon", "coordinateFormat": "EPSG:4326", "layerType": "parks",
            "geojsonObject": { "type": "FeatureCollection", "features": [
              { "type": "Feature", "properties": { "kind": "multipolygon" },
                "geometry": { "type": "MultiPolygon", "bbox": [-87.64, 41.88, -87.61, 41.89], "coordinates": [
                  [[[-87.64, 41.88], [-87.63, 41.88], [-87.63, 41.89], [-87.64, 41.89], [-87.64, 41.88]]],
                  [[[-87.62, 41.88], [-87.61, 41.88], [-87.61, 41.89], [-87.62, 41.89], [-87.62, 41.88]]]
                ] } }
            ] }
          },
          {
