      },
      "handsOn": [["point", "points", 1, null], ["multipoint", "points", 1, null], ["linestring", "polylines", 1, null],
        ["multilinestring", "polylines", 1, null], ["polygon", "polygons", 1, null], ["multipolygon", "parks", 1, null],
        ["collection", "polygons", 1, null]]
    },
    {
      "name": "an OpenStreetMap load in a workspace, its OpenStreetMap table dropped",
      "document": {
        "data": [
          {
            "type": "osm", "workspace": "east", "pbfFileUrl": "docs/examples/data/lower_mnt.osm.pbf", "outputTableName": "tip",
            "queryArea": { "bbox": [-74.0194, 40.7, -74.0085, 40.7085] },
            "autoLoadLayers": { "layers": ["parks"], "dropOsmTable": true }
          }
        ]
      },
      "handsOn": [["tip_parks", "parks", null, "east"]],
      "files": ["docs/examples/data/lower_mnt.osm.pbf"]
    },
    {
      "name": "a join of centroids in a workspace, one aggregate normalized",
      "document": {
        "data": [
          {
            "type": "geojson", "workspace": "east", "outputTableName": "zones", "coordinateFormat": "EPSG:4326",
            "geojsonObject": { "type": "FeatureCollection", "features": [
              { "type": "Feature", "properties": { "zone": 1 }, "geometry": { "type": "Polygon",
                "coordinates": [[[-87.64, 41.87], [-87.62, 41.87], [-87.62, 41.89], [-87.64, 41.89], [-87.64, 41.87]]] } },
              { "type": "Feature", "properties": { "zone": 2 }, "geometry": { "type": "Polygon",
                "coordinates": [[[-87.60, 41.87], [-87.58, 41.87], [-87.58, 41.89], [-87.60, 41.89], [-87.60, 41.87]]] } }
            ] }
          },
          {
            "type": "geojson", "workspace": "east", "outputTableName": "stops", "coordinateFormat": "EPSG:4326",
            "geojsonObject": { "type": "FeatureCollection", "features": [
              { "type": "Feature", "properties": { "riders": 4 }, "geometry": { "type": "Point", "coordinates": [-87.63, 41.88] } },
              { "type": "Feature", "properties": { "riders": 6 }, "geometry": { "type": "Point", "coordinates": [-87.6301, 41.8801] } },
              { "type": "Feature", "properties": { "riders": 2 }, "geometry": { "type": "Point", "coordinates": [-87.59, 41.88] } }
            ] }
          },
          {
            "type": "join", "workspace": "east", "dataRef": "zones", "joinDataRef": "stops",
            "near": { "distance": 300, "useCentroid": true },
            "groupBy": [{ "column": "riders", "aggregateFn": "sum" }, { "column": "riders", "aggregateFn": "max", "normalize": true }]
          }
        ]
