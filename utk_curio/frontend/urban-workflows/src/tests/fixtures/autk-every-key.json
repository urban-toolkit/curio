{
  "description": "Documents that write every key of autk-grammar 5.0.0's maps, plots and compute passes, a family to a document, on the tables an upstream Autark node hands on: `lines`, in the default workspace and in `east`. views: a map of every layer key and a plot of every mark with every plot key, each of which an Autark node hands the grammar as written; passes: a compute step's GPGPU and render passes with every pass key, which reach autk-compute (src/tests/adapters/node/autkEveryKey.test.tsx). Every document passes the agents' document check (backend/tests/test_agents/test_autk_every_key_documents.py). utk_curio/backend/tests/autk_grammar_key_tests.json names these tests for each key.",
  "views": [
    {
      "name": "a map of every layer key",
      "document": {
        "$schema": "https://autarkjs.org/schema/autk-grammar/v1.json",
        "map": {
          "id": "every-layer-key",
          "style": "light",
          "workspace": "east",
          "layerRefs": [
            {
              "dataRef": "lines", "title": "By x", "getFnv": "x", "getFnvType": "quantitative", "isColorMap": true,
              "colorMapInterpolator": "interpolateViridis", "colorMapReverse": true,
              "colorMapRange": [-87.5, -87.48], "colorMapCenter": -87.49,
              "normalization": { "mode": "percentile", "lowerPercentile": 5, "upperPercentile": 95 },
              "transferFunction": { "mode": "linear", "gamma": 1.2, "opacityMin": 0.1, "opacityMax": 1, "zeroCenter": -87.49 },
              "opacity": 0.8, "width": 3, "stroke": "#333333", "pointSize": 2, "defaultFnv": 0,
              "isPick": true, "pickedComps": [0], "selectFields": ["x"], "isSkip": false
            },
            {
              "dataRef": "lines", "title": "By kind", "getFnv": "kind", "getFnvType": "categorical", "isColorMap": true,
              "colorMapInterpolator": "schemeTableau10", "colorMapDomain": ["a", "b"], "colorMapLabels": ["Kind a", "Kind b"],
              "catchAllCategory": "Other kinds", "color": "#ff7f0e", "stroke": false
            }
          ]
        }
      }
    },
    {
      "name": "a scatter plot of every plot key",
      "document": {
        "plot": {
          "mark": "scatter", "id": "every-scatter-key", "dataRef": "lines", "workspace": "east", "mapRef": "lines",
          "axis": ["x", "rank"], "color": "#1f77b4", "title": "Scatter", "width": 420, "height": 300,
          "margins": { "left": 40, "right": 10, "top": 20, "bottom": 30 },
          "events": ["click", "brush"], "selectFields": ["x"],
          "transform": { "preset": "sort", "options": { "by": "x" } }
        }
      }
    },
    {
      "name": "a bar chart of every plot key",
      "document": {
        "plot": {
          "mark": "bar", "id": "every-bar-key", "dataRef": "lines", "workspace": "east", "mapRef": "lines",
          "axis": ["x"], "color": "#2ca02c", "title": "Bars", "width": 400, "height": 280,
          "margins": { "left": 36, "right": 8, "top": 16, "bottom": 32 },
          "events": ["click", "brushX"], "selectFields": ["x"],
          "transform": { "preset": "binning-1d", "options": { "bins": 3 } }
        }
      }
    },
    {
      "name": "a line chart of every plot key",
      "document": {
        "plot": {
          "mark": "line", "id": "every-line-key", "dataRef": "lines", "workspace": "east", "mapRef": "lines",
          "axis": ["rank", "x"], "color": "#d62728", "title": "Line", "width": 400, "height": 260,
          "margins": { "left": 44, "right": 12, "top": 18, "bottom": 28 },
          "events": ["brushX"], "selectFields": ["x"],
          "transform": { "preset": "reduce-series", "options": { "series": "kind" } }
        }
      }
    },
    {
      "name": "a linechart of every plot key",
      "document": {
        "plot": {
          "mark": "linechart", "id": "every-linechart-key", "dataRef": "lines", "workspace": "east", "mapRef": "lines",
          "axis": ["rank", "x"], "color": "#9467bd", "title": "Linechart", "width": 380, "height": 240,
          "margins": { "left": 42, "right": 10, "top": 14, "bottom": 26 },
          "events": ["brushX"], "selectFields": ["x"],
          "transform": { "preset": "binning-events", "options": { "bins": 2 } }
        }
      }
    },
    {
      "name": "parallel coordinates of every plot key",
      "document": {
        "plot": {
          "mark": "parallel-coordinates", "id": "every-parallel-key", "dataRef": "lines", "workspace": "east", "mapRef": "lines",
          "axis": ["x", "rank"], "color": "#8c564b", "title": "Parallel", "width": 440, "height": 300,
          "margins": { "left": 30, "right": 30, "top": 24, "bottom": 20 },
          "events": ["brushY"], "selectFields": ["x"],
          "transform": { "preset": "sort", "options": { "by": "rank" } }
        }
      }
    },
    {
      "name": "a table of every plot key",
      "document": {
        "plot": {
          "mark": "table", "id": "every-table-key", "dataRef": "lines", "workspace": "east", "mapRef": "lines",
          "axis": ["x", "kind", "rank"], "color": "#e377c2", "title": "Table", "width": 360, "height": 220,
          "margins": { "left": 10, "right": 10, "top": 10, "bottom": 10 },
          "events": ["click"], "selectFields": ["x"],
          "transform": { "preset": "sort", "options": { "by": "rank" } }
        }
      }
    },
    {
      "name": "a heatmatrix of every plot key",
      "document": {
        "plot": {
          "mark": "heatmatrix", "id": "every-heatmatrix-key", "dataRef": "lines", "workspace": "east", "mapRef": "lines",
          "axis": ["x", "rank"], "color": "#17becf", "title": "Heatmatrix", "width": 400, "height": 400,
          "margins": { "left": 50, "right": 10, "top": 20, "bottom": 50 },
          "events": ["click"], "selectFields": ["x"],
          "transform": { "preset": "binning-2d", "options": { "bins": 2 } }
        }
      }
    }
  ],
  "passes": [
    {
      "name": "GPGPU passes of every pass key",
      "document": {
        "compute": [
          {
            "type": "gpgpu", "dataRef": "lines", "workspace": "east",
            "attributes": { "x": "x", "xs": "xs", "box": "box" },
            "attributeArrays": { "xs": 2 },
            "attributeMatrices": { "box": { "rows": "auto", "cols": 2 } },
            "uniforms": {
              "scale": 2,
              "second": { "fromFeature": { "layer": "lines", "path": "properties.x", "index": 1 }, "default": 0, "cols": 1 },
              "missing": { "fromFeature": { "layer": "lines", "path": "properties.nothing", "index": 0 }, "default": 7 }
            },
            "uniformArrays": { "weights": [0.5, 0.25] },
            "uniformMatrices": {
              "turn": { "data": [[0, 1], [1, 0]], "cols": 2 },
              "fallback": { "fromFeature": { "layer": "lines", "path": "properties.nothing", "index": 2, "required": false }, "cols": 2, "default": [[0, 0]] }
            },
            "wgslFunction": ["let y = x * scale;", "return y;"],
            "outputColumnName": "y", "outputTableName": "lines_y", "layerType": "points"
          },
          {
            "dataRef": "lines", "workspace": "east", "attributes": { "x": "x" },
            "wgslFunction": "return array<f32, 2>(x, x);", "outputColumns": ["a", "b"]
          }
        ]
      }
    },
    {
      "name": "a render pass of every pass key",
      "document": {
        "compute": [
          {
            "type": "render", "workspace": "east", "outputTableName": "seen", "layerType": "points", "tileSize": 32,
            "layers": [{ "id": "streets", "dataRef": "lines", "type": "polylines", "objectIdProperty": "rank" }],
            "viewpoints": {
              "dataRef": "lines",
              "strategy": { "type": "centroid" },
              "sampling": { "directions": 4, "pitchDeg": 10, "azimuthOffsetDeg": 45 }
            },
            "aggregation": { "type": "objects" },
            "camera": { "fov": 60, "clip": { "near": 0.5, "far": 2000 } }
          }
        ]
      }
    }
  ],
  "data": [
    {
      "name": "CSV and JSON tables, from files and written inline, by every geometry column",
      "document": {
        "data": [
          {
            "type": "csv", "csvFileUrl": "utk_curio/backend/tests/test_frontend/data/autark_stations.csv", "delimiter": ";",
            "outputTableName": "stations_wkt", "geometryColumns": { "wktColumnName": "wkt", "coordinateFormat": "EPSG:4326" }
          },
          {
            "type": "csv", "workspace": "east", "outputTableName": "stations_latlon", "delimiter": "|",
            "csvObject": [["name", "lat", "lon", "riders"], ["Clark/Lake", 41.8857, -87.6309, 11000], ["Quincy", 41.8788, -87.6378, 7000]],
            "geometryColumns": { "latColumnName": "lat", "longColumnName": "lon", "coordinateFormat": "EPSG:4326" }
          },
          {
            "type": "json", "jsonFileUrl": "utk_curio/backend/tests/test_frontend/data/autark_stops.json",
            "outputTableName": "stops_latlon", "geometryColumns": { "latColumnName": "lat", "longColumnName": "lon", "coordinateFormat": "EPSG:4326" }
          },
          {
            "type": "json", "workspace": "east", "outputTableName": "stops_wkt",
            "jsonObject": [{ "name": "Union", "wkt": "POINT(-87.6403 41.8787)" }, { "name": "Ogilvie", "wkt": "POINT(-87.6402 41.8825)" }],
            "geometryColumns": { "wktColumnName": "wkt", "coordinateFormat": "EPSG:4326" }
          }
        ]
      },
      "handsOn": [["stations_wkt", "points", 3, null], ["stops_latlon", "points", 3, null], ["stations_latlon", "points", 2, "east"], ["stops_wkt", "points", 2, "east"]],
      "files": ["utk_curio/backend/tests/test_frontend/data/autark_stations.csv", "utk_curio/backend/tests/test_frontend/data/autark_stops.json"]
    },
    {
      "name": "a CSV table with no geometry columns",
      "document": {
        "data": [
          { "type": "csv", "outputTableName": "ridership", "csvObject": [["name", "riders"], ["Clark/Lake", 11000], ["Quincy", 7000]] }
        ]
      },
      "rows": [["ridership", 2, null]]
    },
    {
      "name": "GeoJSON of every geometry, with every box",
      "document": {
        "data": [
          {
            "type": "geojson", "outputTableName": "point", "coordinateFormat": "EPSG:4326",
            "boundingBox": { "minLon": -87.66, "minLat": 41.86, "maxLon": -87.6, "maxLat": 41.9 },
            "geojsonObject": { "type": "FeatureCollection", "bbox": [-87.64, 41.88, -87.64, 41.88], "features": [
              { "type": "Feature", "id": 1, "bbox": [-87.64, 41.88, -87.64, 41.88], "properties": { "kind": "point" },
                "geometry": { "type": "Point", "bbox": [-87.64, 41.88, -87.64, 41.88], "coordinates": [-87.64, 41.88] } }
            ] }
          },
          {
            "type": "geojson", "outputTableName": "multipoint", "coordinateFormat": "EPSG:4326",
            "geojsonObject": { "type": "FeatureCollection", "features": [
              { "type": "Feature", "id": "mp", "properties": { "kind": "multipoint" },
                "geometry": { "type": "MultiPoint", "bbox": [-87.64, 41.88, -87.63, 41.885], "coordinates": [[-87.64, 41.88], [-87.63, 41.885]] } }
            ] }
          },
          {
            "type": "geojson", "outputTableName": "linestring", "coordinateFormat": "EPSG:4326",
            "geojsonObject": { "type": "FeatureCollection", "features": [
              { "type": "Feature", "properties": { "kind": "linestring" },
                "geometry": { "type": "LineString", "bbox": [-87.64, 41.88, -87.63, 41.885], "coordinates": [[-87.64, 41.88], [-87.63, 41.885]] } }
            ] }
          },
          {
            "type": "geojson", "outputTableName": "multilinestring", "coordinateFormat": "EPSG:4326",
            "geojsonObject": { "type": "FeatureCollection", "features": [
              { "type": "Feature", "properties": { "kind": "multilinestring" },
                "geometry": { "type": "MultiLineString", "bbox": [-87.64, 41.88, -87.62, 41.89],
                  "coordinates": [[[-87.64, 41.88], [-87.63, 41.885]], [[-87.63, 41.885], [-87.62, 41.89]]] } }
            ] }
