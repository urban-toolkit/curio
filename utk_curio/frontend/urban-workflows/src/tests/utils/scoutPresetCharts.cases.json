{
  "description": "Scout's charts of the seven chart presets: each case a template, the values of its widgets, and the spec it draws over two boxes' rows, its data block left out (it names the dataset inputs) and its channels on scenario_name filled in from labels. scoutPresetCharts.test.ts checks that each template draws exactly its case's spec.",
  "labels": [
    {
      "scenario": "s-base",
      "name": "Baseline",
      "color": "#2a9d8f"
    },
    {
      "scenario": "s-tall",
      "name": "Twice as tall",
      "color": "#e76f51"
    }
  ],
  "cases": [
    {
      "name": "bar",
      "template": "bars",
      "widgets": {
        "y": "hour",
        "combine": "mean",
        "y_title": "mean of hour"
      },
      "spec": {
        "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
        "mark": {
          "type": "bar",
          "tooltip": true
        },
        "encoding": {
          "x": {
            "field": "scenario_name",
            "type": "nominal",
            "title": "Scenario",
            "sort": [
              "Baseline",
              "Twice as tall"
            ],
            "axis": {
              "labelAngle": 0
            }
          },
          "y": {
            "field": "hour",
            "type": "quantitative",
            "aggregate": "mean",
            "title": "mean of hour"
          },
          "color": {
            "field": "scenario_name",
            "type": "nominal",
            "title": "Scenario",
            "scale": {
              "domain": [
                "Baseline",
                "Twice as tall"
              ],
              "range": [
                "#2a9d8f",
                "#e76f51"
              ]
            }
          }
        }
      }
    },
    {
