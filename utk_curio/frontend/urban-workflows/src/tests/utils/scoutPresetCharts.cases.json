    {
      "name": "pie",
      "template": "pie",
      "widgets": {
        "value": "hour",
        "combine": "sum",
        "value_title": "sum of hour"
      },
      "spec": {
        "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
        "encoding": {
          "theta": {
            "field": "hour",
            "type": "quantitative",
            "aggregate": "sum",
            "title": "sum of hour",
            "stack": true
          },
          "color": {
            "field": "scenario_name",
            "type": "nominal",
            "title": "Scenario",
            "scale": {
              "domain": [
                "Baseline",
                "Twice as tall"
              ],
              "range": [
                "#2a9d8f",
                "#e76f51"
              ]
            }
          }
        },
        "layer": [
          {
            "mark": {
              "type": "arc",
              "tooltip": true
            }
          },
          {
            "mark": {
              "type": "text",
              "radius": {
                "expr": "min(width, height) / 3"
              },
              "fontWeight": "bold",
              "fill": "white"
            },
            "encoding": {
              "text": {
                "field": "hour",
                "type": "quantitative",
                "aggregate": "sum",
                "title": "sum of hour",
                "format": ",.3~f"
              }
            }
          }
        ]
      }
    },
