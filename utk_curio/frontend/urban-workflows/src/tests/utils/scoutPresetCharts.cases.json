    {
      "name": "table",
      "template": "table",
      "widgets": {
        "columns": [
          "scenario_name",
          "segment",
          "hour",
          "sunlight"
        ]
      },
      "spec": {
        "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
        "transform": [
          {
            "window": [
              {
                "op": "row_number",
                "as": "curio_row"
              }
            ]
          },
          {
            "filter": "datum.curio_row <= 40"
          },
          {
            "fold": [
              "scenario_name",
              "segment",
              "hour",
              "sunlight"
            ],
            "as": [
              "curio_column",
              "curio_cell"
            ]
          }
        ],
        "mark": {
          "type": "text",
          "align": "left",
          "tooltip": true
        },
        "encoding": {
          "y": {
            "field": "curio_row",
            "type": "ordinal",
            "axis": null
          },
          "x": {
            "field": "curio_column",
            "type": "nominal",
            "sort": [
              "scenario_name",
              "segment",
              "hour",
              "sunlight"
            ],
            "title": null,
            "axis": {
              "orient": "top",
              "labelAngle": 0,
              "domain": false,
              "ticks": false
            }
          },
          "text": {
            "field": "curio_cell",
            "type": "nominal"
          },
          "color": {
            "field": "scenario_name",
            "type": "nominal",
            "title": "Scenario",
            "scale": {
              "domain": [
                "Baseline",
                "Twice as tall"
              ],
              "range": [
                "#2a9d8f",
                "#e76f51"
              ]
            },
            "legend": null
          }
        }
