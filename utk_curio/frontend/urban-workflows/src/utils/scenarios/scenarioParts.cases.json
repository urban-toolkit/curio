{
  "about": "What a scenario is made of (#662), by role: its Scenario-specific nodes (\"nodes\"), its own last nodes (\"last\", those of its nodes whose output nothing in it reads, or that something outside it reads), its Shared context and Shared outcomes as it keeps them (or as Curio infers them when it keeps none), and its boundary, what crosses into it or into one of its shared outcomes from outside every box and every shared outcome; what saves its output because of the scenarios (\"saves\"), what stands for each one's boundary, own last nodes and shared outcomes; and the nodes whose saved outputs stand for a node's. Nodes and edges are written as a saved spec holds them. Read by src/tests/utils/scenarioParts.cases.test.ts, which hands them to the canvas as nodes, and by utk_curio/backend/tests/test_scenario_catalog/test_parts.py: the canvas and the Scenario Catalog read a scenario the same way.",
  "cases": [
    {
      "name": "a scenario reads a loader outside it, and the node it feeds is its shared outcome",
      "nodes": [
        {"id": "load", "type": "curio.builtin/data-loading@1", "content": "return 1"},
        {"id": "a", "type": "curio.builtin/computation-analysis@1", "content": "return input_0"},
        {"id": "b", "type": "curio.builtin/computation-analysis@1", "content": "return input_0"}
      ],
      "edges": [
        {"source": "load", "target": "a"},
        {"source": "a", "target": "b"}
      ],
      "scenarios": [{"id": "s1", "nodes": ["a"], "context": ["load"], "outcomes": ["b"]}],
      "expected": {"s1": {"nodes": ["a"], "last": ["a"], "context": ["load"], "outcomes": ["b"], "boundary": ["load"]}},
      "saves": ["a", "b", "load"],
      "savedSources": {"load": ["load"], "b": ["b"]}
    },
    {
      "name": "a node deeper upstream is shared context, and its output saves nothing",
      "nodes": [
        {"id": "raw", "type": "curio.builtin/data-loading@1", "content": "return 1"},
        {"id": "clean", "type": "curio.builtin/computation-analysis@1", "content": "return input_0"},
        {"id": "a", "type": "curio.builtin/computation-analysis@1", "content": "return input_0"},
        {"id": "out", "type": "curio.builtin/computation-analysis@1", "content": "return input_0"}
      ],
      "edges": [
        {"source": "raw", "target": "clean"},
        {"source": "clean", "target": "a"},
        {"source": "a", "target": "out"}
      ],
      "scenarios": [{"id": "s1", "nodes": ["a"], "context": ["raw", "clean"], "outcomes": ["out"]}],
      "expected": {"s1": {"nodes": ["a"], "last": ["a"], "context": ["raw", "clean"], "outcomes": ["out"], "boundary": ["clean"]}},
      "saves": ["a", "clean", "out"]
    },
    {
      "name": "a scenario that keeps no lists gets the ones Curio infers, stopping at every box",
      "nodes": [
        {"id": "raw", "type": "curio.builtin/data-loading@1", "content": "return 1"},
        {"id": "clean", "type": "curio.builtin/computation-analysis@1", "content": "return input_0"},
        {"id": "a", "type": "curio.builtin/computation-analysis@1", "content": "return input_0"},
        {"id": "b", "type": "curio.builtin/computation-analysis@1", "content": "return input_0"},
        {"id": "out", "type": "curio.builtin/computation-analysis@1", "content": "return input_0"},
        {"id": "after", "type": "curio.builtin/computation-analysis@1", "content": "return input_0"}
      ],
      "edges": [
        {"source": "raw", "target": "clean"},
        {"source": "clean", "target": "a"},
        {"source": "a", "target": "out"},
        {"source": "out", "target": "b"},
        {"source": "b", "target": "after"}
      ],
      "scenarios": [{"id": "s1", "nodes": ["a"]}, {"id": "s2", "nodes": ["b"]}],
      "expected": {
        "s1": {"nodes": ["a"], "last": ["a"], "context": ["raw", "clean"], "outcomes": ["out"], "boundary": ["clean"]},
        "s2": {"nodes": ["b"], "last": ["b"], "context": ["out"], "outcomes": ["after"], "boundary": ["out"]}
      },
      "saves": ["a", "after", "b", "clean", "out"]
    },
    {
      "name": "two scenarios of one set read one context and feed one comparison, each saved once",
      "nodes": [
        {"id": "load", "type": "curio.builtin/data-loading@1", "content": "return 1"},
        {"id": "a", "type": "curio.builtin/computation-analysis@1", "content": "return input_0"},
        {"id": "b", "type": "curio.builtin/computation-analysis@1", "content": "return input_0"},
        {"id": "compare", "type": "curio.builtin/computation-analysis@1", "content": "return input_0"}
      ],
      "edges": [
        {"source": "load", "target": "a"},
        {"source": "load", "target": "b"},
        {"source": "a", "target": "compare", "targetHandle": "in"},
        {"source": "b", "target": "compare", "targetHandle": "in_1"}
      ],
      "scenarios": [
        {"id": "s1", "nodes": ["a"], "context": ["load"], "outcomes": ["compare"]},
        {"id": "s2", "nodes": ["b"], "context": ["load"], "outcomes": ["compare"]}
      ],
      "expected": {
        "s1": {"nodes": ["a"], "last": ["a"], "context": ["load"], "outcomes": ["compare"], "boundary": ["load"]},
        "s2": {"nodes": ["b"], "last": ["b"], "context": ["load"], "outcomes": ["compare"], "boundary": ["load"]}
      },
      "saves": ["a", "b", "compare", "load"]
    },
    {
      "name": "a context node a shared outcome reads itself is the boundary too",
      "nodes": [
        {"id": "layers", "type": "curio.builtin/data-loading@1", "content": "return 1"},
        {"id": "prep", "type": "curio.builtin/computation-analysis@1", "content": "return input_0"},
        {"id": "a", "type": "curio.builtin/computation-analysis@1", "content": "return input_0"},
        {"id": "map", "type": "curio.builtin/computation-analysis@1", "content": "return input_0"}
      ],
      "edges": [
        {"source": "layers", "target": "prep"},
        {"source": "prep", "target": "a"},
        {"source": "a", "target": "map", "targetHandle": "in"},
        {"source": "layers", "target": "map", "targetHandle": "in_1"}
      ],
      "scenarios": [{"id": "s1", "nodes": ["a"], "context": ["layers", "prep"], "outcomes": ["map"]}],
      "expected": {"s1": {"nodes": ["a"], "last": ["a"], "context": ["layers", "prep"], "outcomes": ["map"], "boundary": ["layers", "prep"]}},
      "saves": ["a", "layers", "map", "prep"]
    },
    {
      "name": "a shared outcome reading another is no boundary of it",
      "nodes": [
        {"id": "a", "type": "curio.builtin/computation-analysis@1", "content": "return 1"},
        {"id": "change", "type": "curio.builtin/computation-analysis@1", "content": "return input_0"},
        {"id": "chart", "type": "curio.builtin/vis-vega@1", "content": "{}"}
      ],
      "edges": [
        {"source": "a", "target": "change"},
        {"source": "change", "target": "chart"}
      ],
      "scenarios": [{"id": "s1", "nodes": ["a"], "context": [], "outcomes": ["change", "chart"]}],
      "expected": {"s1": {"nodes": ["a"], "last": ["a"], "context": [], "outcomes": ["change", "chart"], "boundary": []}},
      "saves": ["a", "change"],
      "savedSources": {"chart": ["change"]}
    },
    {
      "name": "a chart or a Data Pool stands for the nodes feeding it",
      "nodes": [
        {"id": "load", "type": "curio.builtin/data-loading@1", "content": "return 1"},
        {"id": "pool", "type": "curio.builtin/data-pool@1", "content": ""},
        {"id": "calc", "type": "curio.builtin/computation-analysis@1", "content": "return input_0"},
        {"id": "chart", "type": "curio.builtin/vis-vega@1", "content": "{}"}
      ],
      "edges": [
        {"source": "load", "target": "pool"},
        {"source": "calc", "target": "chart"},
        {"source": "pool", "target": "calc"}
      ],
      "scenarios": [{"id": "s1", "nodes": ["calc"], "context": ["load", "pool"], "outcomes": ["chart"]}],
      "expected": {"s1": {"nodes": ["calc"], "last": ["calc"], "context": ["load", "pool"], "outcomes": ["chart"], "boundary": ["pool"]}},
      "saves": ["calc", "load"],
      "savedSources": {"pool": ["load"], "chart": ["calc"]}
    },
    {
      "name": "a value node wired into a scenario's node is its boundary, and its saved output stands for it",
      "nodes": [
        {"id": "season", "type": "curio.builtin/computation-analysis@1", "content": "return [!! season !!]", "metadata": {"widgets": [{"name": "season", "type": "text", "default": "winter"}]}},
        {"id": "other", "type": "curio.builtin/computation-analysis@1", "content": "return [!! unused !!]", "metadata": {"widgets": [{"name": "unused", "type": "number", "default": 1}]}},
        {"id": "a", "type": "curio.builtin/computation-analysis@1", "content": "return input_0"}
      ],
      "edges": [{"source": "season", "target": "a"}],
      "scenarios": [{"id": "s1", "nodes": ["a"], "context": ["season"], "outcomes": []}],
      "expected": {"s1": {"nodes": ["a"], "last": ["a"], "context": ["season"], "outcomes": [], "boundary": ["season"]}},
      "saves": ["a", "season"],
      "savedSources": {"season": ["season"]}
    },
    {
      "name": "an interaction link between two charts is not a dataflow edge",
      "nodes": [
        {"id": "pool", "type": "curio.builtin/data-pool@1", "content": ""},
        {"id": "chart", "type": "curio.builtin/vis-vega@1", "content": "{}"},
        {"id": "other", "type": "curio.builtin/vis-vega@1", "content": "{}"}
      ],
      "edges": [
        {"source": "pool", "target": "chart"},
        {"source": "other", "target": "chart", "sourceHandle": "in/out", "targetHandle": "in/out", "type": "Interaction"}
      ],
      "scenarios": [{"id": "s1", "nodes": ["chart"], "context": ["pool"], "outcomes": []}],
      "expected": {"s1": {"nodes": ["chart"], "last": ["chart"], "context": ["pool"], "outcomes": [], "boundary": ["pool"]}},
      "saves": []
    },
    {
      "name": "an Autark node that draws stands for its input; one that makes layers saves its own",
      "nodes": [
        {"id": "layers", "type": "curio.builtin/autk-grammar@1", "content": "{\"data\": [{\"name\": \"roads\"}]}"},
        {"id": "map", "type": "curio.builtin/autk-grammar@1", "content": "{\"map\": {\"layers\": []}}"}
      ],
      "edges": [{"source": "layers", "target": "map"}],
      "scenarios": [{"id": "s1", "nodes": ["layers"], "context": [], "outcomes": ["map"]}],
      "expected": {"s1": {"nodes": ["layers"], "last": ["layers"], "context": [], "outcomes": ["map"], "boundary": []}},
      "saves": ["layers"],
      "savedSources": {"layers": ["layers"], "map": ["layers"]}
    },
    {
      "name": "a node that is not on the canvas, or that is in a box, is left out",
      "nodes": [
        {"id": "a", "type": "curio.builtin/computation-analysis@1", "content": "return 1"},
        {"id": "b", "type": "curio.builtin/computation-analysis@1", "content": "return input_0"},
        {"id": "c", "type": "curio.builtin/computation-analysis@1", "content": "return input_0"}
      ],
      "edges": [
        {"source": "a", "target": "b"},
        {"source": "b", "target": "c"}
      ],
      "scenarios": [
        {"id": "s1", "nodes": ["gone", "a"], "context": ["gone"], "outcomes": ["b", "c", "gone"]},
        {"id": "s2", "nodes": ["b"], "context": [], "outcomes": []}
      ],
      "expected": {
        "s1": {"nodes": ["a"], "last": ["a"], "context": [], "outcomes": ["c"], "boundary": []},
        "s2": {"nodes": ["b"], "last": ["b"], "context": [], "outcomes": [], "boundary": ["a"]}
      },
      "saves": ["a", "b", "c"]
    }
  ]
}
