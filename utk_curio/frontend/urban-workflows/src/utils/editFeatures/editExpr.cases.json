{
  "description": "The Map Editor node's expressions and edit log, read by Jest (tests/utils/editExpr.test.ts, through utils/editFeatures/editExpr.ts and applyEdits.ts) and by pytest (utk_curio/sandbox/tests/test_feature_edits.py, through edit_expr.py and curio_edit_features), so the node's table and a run read a condition and apply an edit alike. `expressions`: an expression, one feature's properties (`row`) and what it makes of them. `refusals`: texts that are not expressions. `edits`: a layer's features (their properties, in order), an edit log matched on `key`, the kept features' properties after it, in order, and how many features it removed, changed and restored.",
  "expressions": [
    { "expr": "height > 100", "row": { "height": 120 }, "value": true },
    { "expr": "height > 100", "row": { "height": 80 }, "value": false },
    { "expr": "height > 100", "row": {}, "value": false },
    { "expr": "height <= 100", "row": {}, "value": false },
    { "expr": "height == 12", "row": { "height": 12.0 }, "value": true },
    { "expr": "levels * 3.2", "row": { "levels": 10 }, "value": 32 },
    { "expr": "levels * 3.5", "row": { "levels": 3 }, "value": 10.5 },
    { "expr": "0.1 * 3", "row": {}, "value": 0.3 },
    { "expr": "-height + 1", "row": { "height": 5 }, "value": -4 },
    { "expr": "-a", "row": { "a": 0 }, "value": 0 },
    { "expr": "-(2 + 3)", "row": {}, "value": -5 },
    { "expr": "1 - -1", "row": {}, "value": 2 },
    { "expr": "2 + 3 * 4", "row": {}, "value": 14 },
    { "expr": "(2 + 3) * 4", "row": {}, "value": 20 },
    { "expr": "10 / 4", "row": {}, "value": 2.5 },
    { "expr": "7 % 3", "row": {}, "value": 1 },
    { "expr": "-7 % 3", "row": {}, "value": -1 },
    { "expr": "a / 0", "row": { "a": 1 }, "value": null },
    { "expr": "a % 0", "row": { "a": 1 }, "value": null },
    { "expr": "a + 1", "row": { "a": "x" }, "value": null },
    { "expr": "a + 1", "row": {}, "value": null },
    { "expr": "a + 1", "row": { "a": true }, "value": null },
    { "expr": "kind + '-' + name", "row": { "kind": "tower", "name": "A" }, "value": "tower-A" },
    { "expr": "`Mean Acc shadow` >= 100", "row": { "Mean Acc shadow": 128.6 }, "value": true },
    { "expr": "building:levels > 2", "row": { "building:levels": 3 }, "value": true },
    { "expr": "kind == 'tower' and not (height < 50)", "row": { "kind": "tower", "height": 60 }, "value": true },
    { "expr": "kind == 'tower' or height > 100", "row": { "kind": "house", "height": 10 }, "value": false },
    { "expr": "kind != 'tower'", "row": { "kind": "house" }, "value": true },
    { "expr": "kind == 1", "row": { "kind": "1" }, "value": false },
    { "expr": "kind != 1", "row": { "kind": "1" }, "value": true },
    { "expr": "name > 'b'", "row": { "name": "c" }, "value": true },
    { "expr": "a == b", "row": { "a": "x", "b": "x" }, "value": true },
    { "expr": "flag == true", "row": { "flag": true }, "value": true },
    { "expr": "flag == 1", "row": { "flag": true }, "value": false },
    { "expr": "missing == null", "row": {}, "value": false },
    { "expr": "height and levels", "row": { "height": 0, "levels": 3 }, "value": false },
    { "expr": "height or levels", "row": { "height": 0, "levels": 3 }, "value": true },
    { "expr": "not ''", "row": {}, "value": true },
    { "expr": "not tags", "row": { "tags": [1, 2] }, "value": true },
    { "expr": "tags + 1", "row": { "tags": [1, 2] }, "value": null },
    { "expr": "max(height, 10) + min(1, 2) + abs(-3)", "row": { "height": 4 }, "value": 14 },
    { "expr": "max(a, b)", "row": { "a": 1, "b": "x" }, "value": null },
    { "expr": "abs(-0.5) * 2", "row": {}, "value": 1 },
    { "expr": "round(height / 3, 1)", "row": { "height": 10 }, "value": 3.3 },
    { "expr": "round(2.5)", "row": {}, "value": 3 },
    { "expr": "round(-2.5)", "row": {}, "value": -3 },
    { "expr": "round(0.125, 2)", "row": {}, "value": 0.13 },
    { "expr": "round(1234.5, -2)", "row": {}, "value": 1200 },
    { "expr": "round(a)", "row": { "a": null }, "value": null },
    { "expr": "1e2 + .5", "row": {}, "value": 100.5 },
    { "expr": "\"a b\" == name", "row": { "name": "a b" }, "value": true },
    { "expr": "'it\\'s' == name", "row": { "name": "it's" }, "value": true },
    { "expr": "true", "row": {}, "value": true },
    { "expr": "null", "row": {}, "value": null },
    { "expr": "5", "row": {}, "value": 5 },
    { "expr": "'x'", "row": {}, "value": "x" }
  ],
  "refusals": [
    "",
    "   ",
    "height >",
    "height > > 1",
    "open('x')",
    "a ; b",
    "(a + 1",
    "a + 1)",
    "a b",
    "1 < a < 3",
    "a = 1",
    "a && b",
    "٣ > 1",
    "1e400",
    "abs(1, 2)",
    "round(1, 2, 3)",
    "min()",
    "`unclosed",
    "'unclosed",
    "``",
    "((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((1))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))"
  ],
  "edits": [
    {
      "name": "a remove by id, then a value set on another",
      "key": "building_id",
      "features": [
        { "building_id": 1, "height": 10 },
        { "building_id": 1, "height": 12 },
        { "building_id": 2, "height": 50 },
        { "building_id": 3, "height": 150 }
      ],
      "edits": [
        { "op": "remove", "ids": [1] },
        { "op": "set", "ids": [3], "column": "height", "value": 90 }
      ],
      "expected": [{ "building_id": 2, "height": 50 }, { "building_id": 3, "height": 90 }],
      "counts": { "remove": 2, "set": 1, "restore": 0 }
    },
    {
      "name": "an offset by id, then a scale where a condition holds on the heights the edits before left",
      "key": "building_id",
      "features": [
        { "building_id": 1, "height": 120 },
        { "building_id": 2, "height": 80 },
        { "building_id": 3, "height": 200 }
      ],
      "edits": [
        { "op": "offset", "ids": [2], "column": "height", "value": 30 },
        { "op": "scale", "where": "height > 100", "column": "height", "value": 0.5 }
      ],
      "expected": [{ "building_id": 1, "height": 60 }, { "building_id": 2, "height": 55 }, { "building_id": 3, "height": 100 }],
      "counts": { "remove": 0, "set": 3, "restore": 0 }
    },
    {
      "name": "an expression writes a new column where a condition holds, and a scale skips what holds no number",
      "key": "osm_id",
      "features": [
        { "osm_id": "a", "levels": 10 },
        { "osm_id": "b", "levels": null },
        { "osm_id": "c" }
      ],
      "edits": [
        { "op": "expr", "where": "levels >= 0", "column": "height", "value": "levels * 3.2" },
        { "op": "scale", "ids": ["b", "c"], "column": "levels", "value": 2 }
      ],
      "expected": [{ "osm_id": "a", "levels": 10, "height": 32 }, { "osm_id": "b", "levels": null }, { "osm_id": "c" }],
      "counts": { "remove": 0, "set": 1, "restore": 0 }
    },
    {
      "name": "a switched-off entry is skipped, and its label only names it",
      "key": "building_id",
      "features": [{ "building_id": 1, "height": 10 }, { "building_id": 2, "height": 20 }],
      "edits": [
        { "op": "remove", "ids": [1], "label": "First tower", "enabled": false },
        { "op": "offset", "ids": [2], "column": "height", "value": -5 }
      ],
      "expected": [{ "building_id": 1, "height": 10 }, { "building_id": 2, "height": 15 }],
      "counts": { "remove": 0, "set": 1, "restore": 0 }
    },
    {
      "name": "a restore where a condition holds reads the input",
      "key": "building_id",
      "features": [{ "building_id": 1, "height": 120 }, { "building_id": 2, "height": 20 }],
      "edits": [
        { "op": "remove", "where": "height > 100" },
        { "op": "set", "ids": [2], "column": "height", "value": 25 },
        { "op": "restore", "where": "height > 100" }
      ],
      "expected": [{ "building_id": 1, "height": 120 }, { "building_id": 2, "height": 25 }],
      "counts": { "remove": 0, "set": 1, "restore": 1 }
    },
    {
      "name": "a removed feature is left out of the edits after it",
      "key": "building_id",
      "features": [
        { "building_id": 1, "kind": "tower", "height": 100 },
        { "building_id": 2, "kind": "house", "height": 10 }
      ],
      "edits": [
        { "op": "remove", "where": "kind == 'tower'" },
        { "op": "offset", "where": "height >= 0", "column": "height", "value": 1 }
      ],
      "expected": [{ "building_id": 2, "kind": "house", "height": 11 }],
      "counts": { "remove": 1, "set": 1, "restore": 0 }
    },
    {
      "name": "an expression joins texts, then a text set where a condition holds",
      "key": "osm_id",
      "features": [
        { "osm_id": 1, "kind": "tower", "name": "A" },
        { "osm_id": 2, "kind": "house", "name": "B" }
      ],
      "edits": [
        { "op": "expr", "ids": [1, 2], "column": "label", "value": "kind + ' ' + name" },
        { "op": "set", "where": "kind == 'house'", "column": "kind", "value": "home" }
      ],
      "expected": [
        { "osm_id": 1, "kind": "tower", "name": "A", "label": "tower A" },
        { "osm_id": 2, "kind": "home", "name": "B", "label": "house B" }
      ],
      "counts": { "remove": 0, "set": 2, "restore": 0 }
    },
    {
      "name": "a scale keeps 15 significant digits",
      "key": "building_id",
      "features": [{ "building_id": 1, "height": 0.1 }],
      "edits": [{ "op": "scale", "ids": [1], "column": "height", "value": 3 }],
      "expected": [{ "building_id": 1, "height": 0.3 }],
      "counts": { "remove": 0, "set": 1, "restore": 0 }
    }
  ]
}
