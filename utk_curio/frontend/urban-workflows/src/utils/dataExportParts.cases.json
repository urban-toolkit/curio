          {"dataType": "geodataframe", "data": {"metadata": {"partLabel": "Census tracts with CDC/ATSDR's Social Vulnerability Index 2020"}}},
          {"dataType": "geodataframe", "data": {"metadata": {"partLabel": "CTA 'L' rail lines (City of Chicago)"}}},
          {"dataType": "geodataframe", "data": {"metadata": {"partLabel": "Trees (OpenStreetMap)"}}},
          {"dataType": "geodataframe", "data": {"metadata": {"partLabel": "CTA 'L' rail stations (City of Chicago)"}}}
        ]
