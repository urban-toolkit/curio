{
  "about": "Widget reference substitution cases. Read by src/tests/utils/widgetSubstitution.test.ts and by utk_curio/backend/tests/test_execution/test_widget_substitution.py: the browser and the headless runner must write the same code.",
  "cases": [
    {
      "name": "a number on its own",
      "language": "python",
      "code": "x = [!! n !!]",
      "widgets": [{"name": "n", "type": "number", "default": 10}],
      "expected": "x = 10"
    },
    {
      "name": "a set value wins over the default",
      "language": "python",
      "code": "x = [!! n !!] * 2",
      "widgets": [{"name": "n", "type": "number", "default": 10, "value": 2.5}],
      "expected": "x = 2.5 * 2"
    },
    {
      "name": "numbers print as JavaScript prints them",
      "language": "python",
      "code": "a = [!! a !!]\nb = [!! b !!]\nc = [!! c !!]\nd = [!! d !!]\ne = [!! e !!]\nf = [!! f !!]",
      "widgets": [
        {"name": "a", "type": "number", "default": 1e-7},
        {"name": "b", "type": "number", "default": 0.00001},
        {"name": "c", "type": "number", "default": 1e21},
        {"name": "d", "type": "number", "default": 100.0},
        {"name": "e", "type": "number", "default": -0.5},
        {"name": "f", "type": "number", "default": 123456789012345680000}
      ],
      "expected": "a = 1e-7\nb = 0.00001\nc = 1e+21\nd = 100\ne = -0.5\nf = 123456789012345680000"
    },
    {
      "name": "text on its own is a quoted literal",
      "language": "python",
      "code": "s = [!! s !!]",
      "widgets": [{"name": "s", "type": "text", "default": "it's \"x\" Niterói"}],
      "expected": "s = \"it's \\\"x\\\" Niterói\""
    },
    {
      "name": "text inside a double-quoted string is escaped text",
      "language": "python",
      "code": "title = \"Season: [!! s !!]\"",
      "widgets": [{"name": "s", "type": "text", "default": "winter \"cold\""}],
      "expected": "title = \"Season: winter \\\"cold\\\"\""
    },
    {
      "name": "a choice inside a single-quoted string",
      "language": "python",
      "code": "s = 'it is [!! s !!]'",
      "widgets": [{"name": "s", "type": "choice", "default": "Bob's", "options": {"choices": ["Bob's"]}}],
      "expected": "s = 'it is Bob\\'s'"
    },
    {
      "name": "line breaks and backslashes inside a one-line string",
      "language": "python",
      "code": "s = \"[!! s !!]\"",
      "widgets": [{"name": "s", "type": "text", "default": "a\\b\nc"}],
      "expected": "s = \"a\\\\b\\nc\""
    },
    {
      "name": "a triple-quoted string keeps line breaks",
      "language": "python",
      "code": "doc = \"\"\"note: [!! s !!]\"\"\"",
      "widgets": [{"name": "s", "type": "text", "default": "two\nlines \"q\""}],
      "expected": "doc = \"\"\"note: two\nlines \\\"q\\\"\"\"\""
    },
    {
      "name": "a comment gets the plain text on one line",
      "language": "python",
      "code": "# season is [!! s !!]\nx = [!! s !!]",
      "widgets": [{"name": "s", "type": "text", "default": "win\nter"}],
      "expected": "# season is win ter\nx = \"win\\nter\""
    },
    {
      "name": "a hash inside a string is not a comment",
      "language": "python",
      "code": "x = \"#\"; y = [!! n !!]",
      "widgets": [{"name": "n", "type": "number", "default": 3}],
      "expected": "x = \"#\"; y = 3"
    },
    {
      "name": "an escaped quote does not end the string",
      "language": "python",
      "code": "x = \"a\\\" [!! s !!]\"",
      "widgets": [{"name": "s", "type": "text", "default": "b"}],
      "expected": "x = \"a\\\" b\""
    },
    {
      "name": "an unterminated string ends with its line",
      "language": "python",
      "code": "x = \"abc\ny = [!! n !!]",
      "widgets": [{"name": "n", "type": "number", "default": 4}],
      "expected": "x = \"abc\ny = 4"
    },
    {
      "name": "booleans, lists and ranges in Python",
      "language": "python",
      "code": "a = [!! a !!]; b = [!! b !!]; c = [!! c !!]; d = [!! d !!]",
      "widgets": [
        {"name": "a", "type": "checkbox", "default": true},
        {"name": "b", "type": "number-list", "default": [1, 2.5]},
        {"name": "c", "type": "text-list", "default": ["x", "y"]},
        {"name": "d", "type": "range", "default": [0, 5]}
      ],
      "expected": "a = True; b = [1, 2.5]; c = [\"x\", \"y\"]; d = [0, 5]"
    },
    {
      "name": "a list inside a string is its literal, escaped",
      "language": "python",
      "code": "s = \"[!! c !!]\"",
      "widgets": [{"name": "c", "type": "text-list", "default": ["x"]}],
      "expected": "s = \"[\\\"x\\\"]\""
    },
    {
      "name": "JavaScript booleans, in code and in a line comment",
      "language": "javascript",
      "code": "const a = [!! a !!]; // [!! a !!]",
      "widgets": [{"name": "a", "type": "checkbox", "default": false}],
      "expected": "const a = false; // false"
    },
    {
      "name": "a JavaScript template literal",
      "language": "javascript",
      "code": "const t = `v=${x} [!! s !!]`;",
      "widgets": [{"name": "s", "type": "text", "default": "a`b${c}\\d"}],
      "expected": "const t = `v=${x} a\\`b\\${c}\\\\d`;"
    },
    {
      "name": "a JavaScript block comment",
      "language": "javascript",
      "code": "/* [!! s !!] */ let y = [!! s !!];",
      "widgets": [{"name": "s", "type": "text", "default": "q"}],
      "expected": "/* q */ let y = \"q\";"
    },
    {
      "name": "JSON values",
      "language": "json",
      "code": "{\"opacity\": [!! o !!], \"show\": [!! b !!], \"mark\": [!! m !!]}",
      "widgets": [
        {"name": "o", "type": "number", "default": 0.5},
        {"name": "b", "type": "checkbox", "default": true},
        {"name": "m", "type": "choice", "default": "bar", "options": {"choices": ["bar", "line"]}}
      ],
      "expected": "{\"opacity\": 0.5, \"show\": true, \"mark\": \"bar\"}"
    },
    {
      "name": "inside a JSON string",
      "language": "json",
      "code": "{\"title\": \"Season: [!! s !!]\"}",
      "widgets": [{"name": "s", "type": "text", "default": "a\"b\\c\td"}],
      "expected": "{\"title\": \"Season: a\\\"b\\\\c\\td\"}"
    },
    {
      "name": "no references leaves the code alone",
      "language": "python",
      "code": "x = [1, 2]\n",
      "widgets": [],
      "expected": "x = [1, 2]\n"
    },
    {
      "name": "an old marker is refused",
      "language": "python",
      "code": "x = [!! n$INPUT_VALUE$10 !!]",
      "widgets": [],
      "expected": "x = [!! n$INPUT_VALUE$10 !!]",
      "problems": ["[!! n$INPUT_VALUE$10 !!] is an old widget marker. Add the widget in the node's Widgets tab and drag its tag into the code."]
    },
    {
      "name": "a name the node has no widget for",
      "language": "python",
      "code": "x = [!! missing !!]",
      "widgets": [{"name": "n", "type": "number", "default": 1}],
      "expected": "x = [!! missing !!]",
      "problems": ["[!! missing !!]: this node has no widget named missing. Add it in the Widgets tab."]
    },
    {
      "name": "a reference that is not a name, beside one that resolves",
      "language": "python",
      "code": "x = [!! 2 bad !!] + [!! n !!]",
      "widgets": [{"name": "n", "type": "number", "default": 1}],
      "expected": "x = [!! 2 bad !!] + 1",
      "problems": ["[!! 2 bad !!] does not name a widget. Widget names are letters, digits and underscores."]
    }
  ]
}
