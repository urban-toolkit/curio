{
  "description": "Vega-Lite specs drawn after a Compare Scenarios node, over a stacked table of three scenarios in input order, and what scenarioScales.ts makes of them: every color, fill and stroke on scenario_name takes the scenarios' colors, a text mark's in the Table preset's shades, and every axis, offset and facet on it takes their names as its order. scenarioScales.test.ts checks that withScenarioScales writes exactly these, and leaves each untouched spec as it is; test_compare_scenarios_node.py checks each against the Vega-Lite schema and the columns it reads.",
  "labels": [
    { "scenario": "s-tall", "name": "Twice as tall", "color": "#e76f51" },
    { "scenario": "s-base", "name": "Baseline", "color": "#2a9d8f" },
    { "scenario": "s-roof", "name": "Green roofs", "color": "#a1d99b" }
  ],
  "columns": [
    { "name": "segment", "role": "nominal" },
    { "name": "hour", "role": "quantitative" },
    { "name": "sunlight", "role": "quantitative" }
  ],
  "cases": [
    {
      "name": "bars colored by scenario, with no scale written",
      "spec": {
        "mark": { "type": "bar", "tooltip": true },
        "encoding": {
          "x": { "field": "segment", "type": "nominal" },
          "y": { "field": "sunlight", "type": "quantitative", "aggregate": "mean" },
          "color": { "field": "scenario_name", "type": "nominal", "title": "Scenario" }
        }
      },
      "filled": {
        "mark": { "type": "bar", "tooltip": true },
        "encoding": {
          "x": { "field": "segment", "type": "nominal" },
          "y": { "field": "sunlight", "type": "quantitative", "aggregate": "mean" },
          "color": {
            "field": "scenario_name",
            "type": "nominal",
            "title": "Scenario",
            "scale": {
              "domain": ["Twice as tall", "Baseline", "Green roofs"],
              "range": ["#e76f51", "#2a9d8f", "#a1d99b"]
            }
          }
        }
      }
    },
    {
      "name": "a scale written for the scenarios, reversed, is replaced by theirs",
      "spec": {
        "mark": "line",
        "encoding": {
          "x": { "field": "hour", "type": "quantitative" },
          "y": { "field": "sunlight", "type": "quantitative" },
          "color": {
            "field": "scenario_name",
            "type": "nominal",
            "legend": { "orient": "bottom" },
            "scale": {
              "domain": ["Baseline", "Green roofs", "Twice as tall"],
              "range": ["#111111", "#222222", "#333333"],
              "reverse": true
            }
          }
        }
      },
      "filled": {
        "mark": "line",
        "encoding": {
          "x": { "field": "hour", "type": "quantitative" },
          "y": { "field": "sunlight", "type": "quantitative" },
          "color": {
            "field": "scenario_name",
            "type": "nominal",
            "legend": { "orient": "bottom" },
            "scale": {
              "domain": ["Twice as tall", "Baseline", "Green roofs"],
              "range": ["#e76f51", "#2a9d8f", "#a1d99b"]
            }
          }
        }
      }
    },
    {
      "name": "fill and stroke in layers, a scheme written for one",
      "spec": {
        "encoding": { "x": { "field": "segment", "type": "nominal" } },
        "layer": [
          {
            "mark": "bar",
            "encoding": {
              "y": { "field": "sunlight", "type": "quantitative", "aggregate": "mean" },
              "fill": { "field": "scenario_name", "type": "nominal", "scale": { "scheme": "category10" } }
            }
          },
          {
            "mark": "rule",
            "encoding": {
              "y": { "field": "sunlight", "type": "quantitative", "aggregate": "max" },
              "stroke": { "field": "scenario_name", "type": "nominal" }
            }
          }
        ]
      },
      "filled": {
        "encoding": { "x": { "field": "segment", "type": "nominal" } },
        "layer": [
          {
            "mark": "bar",
            "encoding": {
              "y": { "field": "sunlight", "type": "quantitative", "aggregate": "mean" },
              "fill": {
                "field": "scenario_name",
                "type": "nominal",
                "scale": {
                  "domain": ["Twice as tall", "Baseline", "Green roofs"],
                  "range": ["#e76f51", "#2a9d8f", "#a1d99b"]
                }
              }
            }
          },
          {
            "mark": "rule",
            "encoding": {
              "y": { "field": "sunlight", "type": "quantitative", "aggregate": "max" },
              "stroke": {
                "field": "scenario_name",
                "type": "nominal",
                "scale": {
                  "domain": ["Twice as tall", "Baseline", "Green roofs"],
                  "range": ["#e76f51", "#2a9d8f", "#a1d99b"]
                }
              }
            }
          }
        ]
      }
    },
    {
      "name": "a text mark in the shades a table writes, its rows in input order",
      "spec": {
        "mark": { "type": "text", "align": "left" },
        "encoding": {
          "y": { "field": "scenario_name", "type": "nominal", "title": null },
          "x": { "field": "segment", "type": "nominal" },
          "text": { "field": "sunlight", "type": "quantitative", "format": ".1f" },
          "color": { "field": "scenario_name", "type": "nominal", "legend": null }
        }
      },
      "filled": {
        "mark": { "type": "text", "align": "left" },
        "encoding": {
          "y": {
            "field": "scenario_name",
            "type": "nominal",
            "title": null,
            "sort": ["Twice as tall", "Baseline", "Green roofs"]
          },
          "x": { "field": "segment", "type": "nominal" },
          "text": { "field": "sunlight", "type": "quantitative", "format": ".1f" },
          "color": {
            "field": "scenario_name",
            "type": "nominal",
            "legend": null,
            "scale": {
              "domain": ["Twice as tall", "Baseline", "Green roofs"],
              "range": ["#e76f51", "#2a9d8f", "#769e71"]
            }
          }
        }
      }
    },
    {
      "name": "grouped bars: the offset in input order, over an order written alphabetically",
      "spec": {
        "mark": "bar",
        "encoding": {
          "x": { "field": "segment", "type": "nominal", "sort": ["r2", "r1"] },
          "xOffset": { "field": "scenario_name", "type": "nominal", "sort": ["Baseline", "Green roofs", "Twice as tall"] },
          "y": { "field": "sunlight", "type": "quantitative", "aggregate": "mean" },
          "color": { "field": "scenario_name", "type": "nominal" }
        }
      },
      "filled": {
        "mark": "bar",
        "encoding": {
          "x": { "field": "segment", "type": "nominal", "sort": ["r2", "r1"] },
          "xOffset": {
            "field": "scenario_name",
            "type": "nominal",
            "sort": ["Twice as tall", "Baseline", "Green roofs"]
          },
          "y": { "field": "sunlight", "type": "quantitative", "aggregate": "mean" },
          "color": {
            "field": "scenario_name",
            "type": "nominal",
            "scale": {
              "domain": ["Twice as tall", "Baseline", "Green roofs"],
              "range": ["#e76f51", "#2a9d8f", "#a1d99b"]
            }
          }
        }
      }
    },
    {
      "name": "horizontal grouped bars: the vertical offset in input order",
      "spec": {
        "mark": "bar",
        "encoding": {
          "y": { "field": "segment", "type": "nominal" },
          "yOffset": { "field": "scenario_name", "type": "nominal" },
          "x": { "field": "sunlight", "type": "quantitative", "aggregate": "mean" }
        }
      },
      "filled": {
        "mark": "bar",
        "encoding": {
          "y": { "field": "segment", "type": "nominal" },
          "yOffset": {
            "field": "scenario_name",
            "type": "nominal",
            "sort": ["Twice as tall", "Baseline", "Green roofs"]
          },
          "x": { "field": "sunlight", "type": "quantitative", "aggregate": "mean" }
        }
      }
    },
    {
      "name": "an axis whose scale names the scenarios takes their names as its domain, its padding kept",
      "spec": {
        "mark": { "type": "point", "filled": true },
        "encoding": {
          "y": {
            "field": "scenario_name",
            "type": "nominal",
            "scale": { "domain": ["Baseline", "Twice as tall"], "padding": 0.4 }
          },
          "x": { "field": "sunlight", "type": "quantitative" }
        }
      },
      "filled": {
        "mark": { "type": "point", "filled": true },
        "encoding": {
          "y": {
            "field": "scenario_name",
            "type": "nominal",
            "scale": { "domain": ["Twice as tall", "Baseline", "Green roofs"], "padding": 0.4 }
          },
          "x": { "field": "sunlight", "type": "quantitative" }
        }
      }
    },
    {
      "name": "strips along the scenarios, with a median tick of its own color",
      "spec": {
        "encoding": {
          "x": {
            "field": "scenario_name",
            "type": "nominal",
            "sort": ["Baseline", "Green roofs", "Twice as tall"],
            "axis": { "labelAngle": 0 }
          }
        },
        "layer": [
          {
            "mark": { "type": "tick", "thickness": 2 },
            "encoding": {
              "y": { "field": "sunlight", "type": "quantitative" },
              "color": { "field": "scenario_name", "type": "nominal", "legend": null }
            }
          },
          {
            "mark": { "type": "tick", "color": "#111111" },
            "encoding": { "y": { "field": "sunlight", "type": "quantitative", "aggregate": "median" } }
          }
        ]
      },
      "filled": {
        "encoding": {
          "x": {
            "field": "scenario_name",
            "type": "nominal",
            "sort": ["Twice as tall", "Baseline", "Green roofs"],
            "axis": { "labelAngle": 0 }
          }
        },
        "layer": [
          {
            "mark": { "type": "tick", "thickness": 2 },
            "encoding": {
              "y": { "field": "sunlight", "type": "quantitative" },
              "color": {
                "field": "scenario_name",
                "type": "nominal",
                "legend": null,
                "scale": {
                  "domain": ["Twice as tall", "Baseline", "Green roofs"],
                  "range": ["#e76f51", "#2a9d8f", "#a1d99b"]
                }
              }
            }
          },
          {
            "mark": { "type": "tick", "color": "#111111" },
            "encoding": { "y": { "field": "sunlight", "type": "quantitative", "aggregate": "median" } }
          }
        ]
      }
    },
    {
      "name": "one panel per scenario, in input order, its lines in their colors",
      "spec": {
        "facet": { "field": "scenario_name", "type": "nominal", "title": null },
        "columns": 3,
        "spec": {
          "mark": "line",
          "encoding": {
            "x": { "field": "hour", "type": "quantitative" },
            "y": { "field": "sunlight", "type": "quantitative" },
            "color": { "field": "scenario_name", "type": "nominal", "legend": null }
          }
        }
      },
      "filled": {
        "facet": {
          "field": "scenario_name",
          "type": "nominal",
          "title": null,
          "sort": ["Twice as tall", "Baseline", "Green roofs"]
        },
        "columns": 3,
        "spec": {
          "mark": "line",
          "encoding": {
            "x": { "field": "hour", "type": "quantitative" },
            "y": { "field": "sunlight", "type": "quantitative" },
            "color": {
              "field": "scenario_name",
              "type": "nominal",
              "legend": null,
              "scale": {
                "domain": ["Twice as tall", "Baseline", "Green roofs"],
                "range": ["#e76f51", "#2a9d8f", "#a1d99b"]
              }
            }
          }
        }
      }
    },
    {
      "name": "a row per scenario in input order, a column per segment as written",
      "spec": {
        "facet": {
          "row": { "field": "scenario_name", "type": "nominal" },
          "column": { "field": "segment", "type": "nominal" }
        },
        "spec": {
          "mark": "bar",
          "encoding": {
            "x": { "field": "hour", "type": "ordinal" },
            "y": { "field": "sunlight", "type": "quantitative" }
          }
        }
      },
      "filled": {
        "facet": {
          "row": {
            "field": "scenario_name",
            "type": "nominal",
            "sort": ["Twice as tall", "Baseline", "Green roofs"]
          },
          "column": { "field": "segment", "type": "nominal" }
        },
        "spec": {
          "mark": "bar",
          "encoding": {
            "x": { "field": "hour", "type": "ordinal" },
            "y": { "field": "sunlight", "type": "quantitative" }
          }
        }
      }
    },
    {
      "name": "a column channel per scenario, in input order",
      "spec": {
        "mark": "bar",
        "encoding": {
          "column": { "field": "scenario_name", "type": "nominal" },
          "x": { "field": "segment", "type": "nominal" },
          "y": { "field": "sunlight", "type": "quantitative", "aggregate": "sum" }
        }
      },
      "filled": {
        "mark": "bar",
        "encoding": {
          "column": {
            "field": "scenario_name",
            "type": "nominal",
            "sort": ["Twice as tall", "Baseline", "Green roofs"]
          },
          "x": { "field": "segment", "type": "nominal" },
          "y": { "field": "sunlight", "type": "quantitative", "aggregate": "sum" }
        }
      }
    },
    {
      "name": "a facet channel per scenario, in input order",
      "spec": {
        "mark": "area",
        "encoding": {
          "facet": { "field": "scenario_name", "type": "nominal", "columns": 2 },
          "x": { "field": "hour", "type": "quantitative" },
          "y": { "field": "sunlight", "type": "quantitative" }
        }
      },
      "filled": {
        "mark": "area",
        "encoding": {
          "facet": {
            "field": "scenario_name",
            "type": "nominal",
            "columns": 2,
            "sort": ["Twice as tall", "Baseline", "Green roofs"]
          },
          "x": { "field": "hour", "type": "quantitative" },
          "y": { "field": "sunlight", "type": "quantitative" }
        }
      }
    },
    {
      "name": "a selection's color by scenario is filled, a condition on a value is not",
      "spec": {
        "params": [{ "name": "pick", "select": { "type": "point", "fields": ["scenario_name"] } }],
        "mark": "bar",
        "encoding": {
          "x": { "field": "segment", "type": "nominal" },
          "y": { "field": "sunlight", "type": "quantitative", "aggregate": "mean" },
          "color": {
            "condition": { "param": "pick", "field": "scenario_name", "type": "nominal" },
            "value": "#cccccc"
          },
          "stroke": { "condition": { "test": "datum.sunlight > 3", "value": "#000000" }, "value": "transparent" }
        }
      },
      "filled": {
        "params": [{ "name": "pick", "select": { "type": "point", "fields": ["scenario_name"] } }],
        "mark": "bar",
        "encoding": {
          "x": { "field": "segment", "type": "nominal" },
          "y": { "field": "sunlight", "type": "quantitative", "aggregate": "mean" },
          "color": {
            "condition": {
              "param": "pick",
              "field": "scenario_name",
              "type": "nominal",
              "scale": {
                "domain": ["Twice as tall", "Baseline", "Green roofs"],
                "range": ["#e76f51", "#2a9d8f", "#a1d99b"]
              }
            },
            "value": "#cccccc"
          },
          "stroke": { "condition": { "test": "datum.sunlight > 3", "value": "#000000" }, "value": "transparent" }
        }
      }
    },
    {
      "name": "views side by side and stacked, a text layer in the shades",
      "spec": {
        "hconcat": [
          {
            "mark": "bar",
            "encoding": {
              "x": { "field": "scenario_name", "type": "nominal" },
              "y": { "field": "sunlight", "type": "quantitative", "aggregate": "mean" },
              "color": { "field": "scenario_name", "type": "nominal" }
            }
          },
          {
            "vconcat": [
              {
                "layer": [
                  {
                    "mark": "line",
                    "encoding": {
                      "x": { "field": "hour", "type": "quantitative" },
                      "y": { "field": "sunlight", "type": "quantitative" },
                      "stroke": { "field": "scenario_name", "type": "nominal" }
                    }
                  },
                  {
                    "mark": { "type": "text", "dx": 4 },
                    "encoding": {
                      "x": { "field": "hour", "type": "quantitative", "aggregate": "max" },
                      "y": { "field": "sunlight", "type": "quantitative", "aggregate": "max" },
                      "text": { "field": "scenario_name", "type": "nominal" },
                      "fill": { "field": "scenario_name", "type": "nominal" }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "filled": {
        "hconcat": [
          {
            "mark": "bar",
            "encoding": {
              "x": {
                "field": "scenario_name",
                "type": "nominal",
                "sort": ["Twice as tall", "Baseline", "Green roofs"]
              },
              "y": { "field": "sunlight", "type": "quantitative", "aggregate": "mean" },
              "color": {
                "field": "scenario_name",
                "type": "nominal",
                "scale": {
                  "domain": ["Twice as tall", "Baseline", "Green roofs"],
                  "range": ["#e76f51", "#2a9d8f", "#a1d99b"]
                }
              }
            }
          },
          {
            "vconcat": [
              {
                "layer": [
                  {
                    "mark": "line",
                    "encoding": {
                      "x": { "field": "hour", "type": "quantitative" },
                      "y": { "field": "sunlight", "type": "quantitative" },
                      "stroke": {
                        "field": "scenario_name",
                        "type": "nominal",
                        "scale": {
                          "domain": ["Twice as tall", "Baseline", "Green roofs"],
                          "range": ["#e76f51", "#2a9d8f", "#a1d99b"]
                        }
                      }
                    }
                  },
                  {
                    "mark": { "type": "text", "dx": 4 },
                    "encoding": {
                      "x": { "field": "hour", "type": "quantitative", "aggregate": "max" },
                      "y": { "field": "sunlight", "type": "quantitative", "aggregate": "max" },
                      "text": { "field": "scenario_name", "type": "nominal" },
                      "fill": {
                        "field": "scenario_name",
                        "type": "nominal",
                        "scale": {
                          "domain": ["Twice as tall", "Baseline", "Green roofs"],
                          "range": ["#e76f51", "#2a9d8f", "#769e71"]
                        }
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      }
    }
  ],
  "untouched": [
    {
      "name": "colored by another column, filtered and labelled by scenario in its transforms",
      "spec": {
        "transform": [
          { "filter": "datum.scenario_name !== 'Baseline'" },
          { "calculate": "datum.scenario_name + ' (' + datum.segment + ')'", "as": "label" }
        ],
        "mark": "bar",
        "encoding": {
          "x": { "field": "label", "type": "nominal" },
          "y": { "field": "sunlight", "type": "quantitative", "aggregate": "mean" },
          "color": {
            "field": "segment",
            "type": "nominal",
            "scale": { "domain": ["r1", "r2"], "range": ["#e76f51", "#2a9d8f"] }
          }
        }
      }
    },
    {
      "name": "shape, dash, detail and tooltip by scenario, which carry no color or order",
      "spec": {
        "mark": "line",
        "encoding": {
          "x": { "field": "hour", "type": "quantitative" },
          "y": { "field": "sunlight", "type": "quantitative" },
          "strokeDash": { "field": "scenario_name", "type": "nominal" },
          "detail": { "field": "scenario_name", "type": "nominal" },
          "tooltip": [
            { "field": "scenario_name", "type": "nominal" },
            { "field": "sunlight", "type": "quantitative" }
          ]
        }
      }
    },
    {
      "name": "points shaped by scenario",
      "spec": {
        "mark": { "type": "point", "filled": true },
        "encoding": {
          "x": { "field": "hour", "type": "quantitative" },
          "y": { "field": "sunlight", "type": "quantitative" },
          "shape": { "field": "scenario_name", "type": "nominal" }
        }
      }
    }
  ]
}
