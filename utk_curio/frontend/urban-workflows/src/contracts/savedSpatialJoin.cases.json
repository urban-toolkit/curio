    {
      "name": "blank code is no code",
      "node": {"id": "j7", "type": "curio.builtin/spatial-join", "content": "  \n", "metadata": {"spatialJoin": {"predicate": "touches"}}},
      "converted": {"id": "j7", "type": "curio.builtin/spatial-join", "content": "<code>", "metadata": {"widgets": [{"value": "touches"}, {}]}}
