    {
      "name": "a join with widgets is left as it is",
      "node": {"id": "j9", "type": "curio.builtin/spatial-join", "content": "", "metadata": {"widgets": [], "spatialJoin": {"predicate": "within"}}},
      "converted": {"id": "j9", "type": "curio.builtin/spatial-join", "content": "", "metadata": {"widgets": [], "spatialJoin": {"predicate": "within"}}}
