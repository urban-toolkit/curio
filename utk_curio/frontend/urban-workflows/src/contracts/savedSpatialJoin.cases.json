{
  "description": "Saved nodes and what they read as (savedSpatialJoin.ts and projects/saved_joins.py run each). In converted, the content <code> is the template's code (savedSpatialJoin.json), and when content is <code>, each widget is the template's widget of its place with the fields given: its value is the setting saved for it.",
  "cases": [
    {
      "name": "a join saved with both settings takes the code and holds them in its widgets",
      "node": {"id": "j1", "type": "curio.builtin/spatial-join", "x": 10, "y": 20, "content": "", "goal": "",
               "metadata": {"keywords": [], "spatialJoin": {"predicate": "within", "output": "counts"}}},
      "converted": {"id": "j1", "type": "curio.builtin/spatial-join", "x": 10, "y": 20, "content": "<code>", "goal": "",
                    "metadata": {"keywords": [], "widgets": [{"value": "within"}, {"value": "counts"}]}}
    },
    {
      "name": "an operation alone leaves Output at its default",
      "node": {"id": "j2", "type": "curio.builtin/spatial-join", "content": "", "metadata": {"spatialJoin": {"predicate": "nearest"}}},
      "converted": {"id": "j2", "type": "curio.builtin/spatial-join", "content": "<code>", "metadata": {"widgets": [{"value": "nearest"}, {}]}}
    },
    {
      "name": "an output alone leaves Operation at its default",
      "node": {"id": "j3", "type": "curio.builtin/spatial-join", "content": "", "metadata": {"spatialJoin": {"output": "counts"}}},
      "converted": {"id": "j3", "type": "curio.builtin/spatial-join", "content": "<code>", "metadata": {"widgets": [{}, {"value": "counts"}]}}
    },
    {
      "name": "a join saved with no settings takes the defaults, as a new join",
      "node": {"id": "j4", "type": "curio.builtin/spatial-join", "content": "", "metadata": {"keywords": []}},
      "converted": {"id": "j4", "type": "curio.builtin/spatial-join", "content": "<code>", "metadata": {"keywords": [], "widgets": [{}, {}]}}
    },
    {
      "name": "a setting that is none of the widget's choices leaves the widget at its default",
      "node": {"id": "j5", "type": "curio.builtin/spatial-join", "content": "",
               "metadata": {"spatialJoin": {"predicate": "near", "output": ["counts"]}}},
      "converted": {"id": "j5", "type": "curio.builtin/spatial-join", "content": "<code>", "metadata": {"widgets": [{}, {}]}}
    },
    {
      "name": "a join with no content, no metadata and a versioned type",
      "node": {"id": "j6", "type": "curio.builtin/spatial-join@1"},
      "converted": {"id": "j6", "type": "curio.builtin/spatial-join@1", "content": "<code>", "metadata": {"widgets": [{}, {}]}}
