  ],
  "endpoint": "packages_api.download_package_archive"
 },
 {
  "rule": "/api/packages/<dir_name>/backend/<handler>",
  "methods": [
   "POST"
  ],
  "endpoint": "packages_api.invoke_package_backend"
 },
 {
  "rule": "/api/packages/<dir_name>/file/<path:filename>",
  "methods": [
   "GET"
  ],
  "endpoint": "packages_api.get_package_file"
 },
 {
