[
 {
  "rule": "/api/packages",
  "methods": [
   "GET"
  ],
  "endpoint": "packages_api.list_installed_packages"
 },
 {
  "rule": "/api/packages/<dir_name>",
  "methods": [
   "DELETE"
  ],
  "endpoint": "packages_api.remove_package"
 },
 {
  "rule": "/api/packages/<dir_name>",
  "methods": [
   "PATCH"
  ],
  "endpoint": "packages_api.patch_package_metadata"
 },
 {
  "rule": "/api/packages/<dir_name>/archive",
  "methods": [
