  "methods": [
   "POST"
  ],
  "endpoint": "packages_api.install_from_catalog"
 },
 {
  "rule": "/api/packages/defaults",
  "methods": [
   "GET"
  ],
  "endpoint": "packages_api.get_defaults_route"
 },
 {
  "rule": "/api/packages/defaults",
  "methods": [
   "POST"
  ],
  "endpoint": "packages_api.install_to_defaults_route"
 },
 {
  "rule": "/api/packages/defaults/<path:dir_name>",
  "methods": [
   "DELETE"
  ],
  "endpoint": "packages_api.uninstall_from_defaults_route"
 },
 {
  "rule": "/api/packages/factory/build",
  "methods": [
   "POST"
  ],
  "endpoint": "packages_api.factory_build"
 },
 {
  "rule": "/api/packages/factory/capabilities",
  "methods": [
   "GET"
  ],
  "endpoint": "packages_api.factory_capabilities"
 },
 {
  "rule": "/api/packages/factory/install",
  "methods": [
   "POST"
  ],
  "endpoint": "packages_api.factory_install"
 },
 {
  "rule": "/api/packages/factory/publish-catalog",
  "methods": [
   "POST"
  ],
  "endpoint": "packages_api.factory_publish_catalog"
 },
 {
  "rule": "/api/packages/libraries",
  "methods": [
   "GET"
  ],
  "endpoint": "packages_api.list_libraries_route"
 },
 {
  "rule": "/api/packages/libraries",
  "methods": [
   "POST"
  ],
  "endpoint": "packages_api.add_library_route"
 },
 {
  "rule": "/api/packages/libraries/<kind>/<path:spec>",
  "methods": [
   "DELETE"
  ],
  "endpoint": "packages_api.remove_library_route"
 },
 {
  "rule": "/api/packages/projects/<project_id>",
  "methods": [
