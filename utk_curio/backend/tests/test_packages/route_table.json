 },
 {
  "rule": "/api/packages/resolve",
  "methods": [
   "POST"
  ],
  "endpoint": "packages_api.resolve_deps"
 },
 {
  "rule": "/api/packages/upload",
  "methods": [
   "POST"
  ],
  "endpoint": "packages_api.upload_package"
 },
 {
  "rule": "/api/packages/workflow-deps/check",
  "methods": [
   "POST"
  ],
  "endpoint": "packages_api.check_workflow_deps"
 },
 {
  "rule": "/api/packages/workflow-deps/install",
  "methods": [
   "POST"
  ],
  "endpoint": "packages_api.install_workflow_deps"
