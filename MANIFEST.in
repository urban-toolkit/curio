include README.md
include pyproject.toml
include LICENSE

# The sandbox's Node.js package list, which setup.py copies into the wheel.
include package.json
include package-lock.json

# The folders Curio ships beside its code, at their repository paths here;
# setup.py puts them, and the files of docs/ below, in the wheel at
# utk_curio/_shipped/<folder>/. agents/ holds everything the agents read: each
# agent's prompts, and the base entry's pages, its folders included.
recursive-include agents *
recursive-include packages *
recursive-include datasets *
recursive-include discovery *

# DuckDB's extensions, which the launcher seeds and the backend serves
# (DUCKDB_EXTENSIONS in utk_curio/sandbox/util/node_runtime.py).
recursive-include vendor/duckdb-extensions *.wasm

# What Curio reads of docs/, which setup.py puts in the wheel at
# utk_curio/_shipped/docs/: the dataflows it ships and use-cases.json, the index
# beside them that names the use cases (projects/shipped.py), the
# agent evaluation's prompt fixtures and their schema, the Trill schema the
# agents' prompt fields project, and the Example storage source's folder with
# the credits of its Mapillary photos. No guide, image, walkthrough or
# screenshot baseline.
include docs/examples/*.json
include docs/examples/dataflows/*.json
recursive-include docs/examples/prompts *.prompt.json
include docs/schemas/example-prompt-fixture.v1.json
include docs/schemas/trill.v1.json
recursive-include docs/examples/data/storage *
include docs/examples/data/mapillary-ATTRIBUTION.md

# The example data the shipped dataflows read by its path, exactly the paths
# their nodes spell (test_pip_wheel_layout.py checks it): the Autark examples'
# OpenStreetMap extracts, which /file/ serves, and the files node code opens.
include docs/examples/data/back_bay.osm.pbf
include docs/examples/data/chicago_downtown.osm.pbf
include docs/examples/data/chicago_loop.osm.pbf
include docs/examples/data/lower_mnt.osm.pbf
include docs/examples/data/niteroi.osm.pbf
include docs/examples/data/niteroi_lst_verao_2001_2024.tif
include docs/examples/data/access_score.geojson
recursive-include docs/examples/data/ImageTest *

# The example model package and its export script, which Curio does not read:
# setuptools would otherwise add the script as a module of docs/.
prune docs/bring-your-own-model

recursive-include utk_curio/backend *
recursive-include utk_curio/sandbox *
recursive-include utk_curio/frontend *

prune utk_curio/frontend/urban-workflows/node_modules

# The built frontend's source maps.
recursive-exclude utk_curio/frontend *.map

# setup.py leaves out of both archives the files a pip install downloads from
# GitHub the first time Curio needs them, so each stays under PyPI's 100 MiB
# limit: those a dataset's or model package's manifest names in
# downloadOnFirstUse.
