include README.md
include pyproject.toml
include LICENSE

# The sandbox's Node.js package list, which setup.py copies into the wheel.
include package.json
include package-lock.json
recursive-include packages *
recursive-include datasets *
recursive-include discovery *
recursive-include models *
recursive-include tests *

recursive-include utk_curio/backend *
recursive-include utk_curio/sandbox *
recursive-include utk_curio/frontend *

# The built-in agents' system and task prompts. Not a Python package (the
# hyphen makes it unimportable, so packages.find cannot see it), so without
# this line an sdist or wheel ships every one of the roster agents with no
# prompt bytes at all, and builtin.read_prompt_text just returns None.
recursive-include utk_curio/llm-prompts *.md

prune utk_curio/frontend/urban-workflows/node_modules

# The built frontend's source maps.
recursive-exclude utk_curio/frontend *.map

# Files a pip install downloads from GitHub the first time Curio needs them,
# so the sdist and the wheel stay under PyPI's 100 MiB limit for one file.
# Exactly the files utk_curio/backend/app/datasets/infrastructure/left_out_files.json
# lists (test_left_out_files.py checks it).
exclude datasets/data.cityofchicago.red-light-violations@1/data/red-light-violations.parquet
exclude datasets/data.cityofchicago.speed-camera-violations@1/data/speed-camera-violations.parquet
exclude datasets/data.projectsidewalk.chicago-labels@1/data/chicago-labels.parquet
exclude datasets/data.utk.milan-mrt@1/data/milan-mrt.tif
exclude models/model.scout.deep-umbra@1/files/deep_umbra.onnx
