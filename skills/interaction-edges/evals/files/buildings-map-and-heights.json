        "width": 900,
        "height": 420,
        "content": "{\n  \"layout\": {\"type\": \"horizontal\", \"gap\": 8},\n  \"map\": {\n    \"id\": \"buildings\",\n    \"layerRefs\": [{\"dataRef\": \"input_0\", \"isPick\": true, \"getFnv\": \"height\", \"getFnvType\": \"quantitative\", \"selectFields\": [\"building_id\"]}]\n  },\n  \"plot\": {\n    \"id\": \"heights\",\n    \"dataRef\": \"input_0\",\n    \"mark\": \"bar\",\n    \"axis\": [\"height\", \"@transform\"],\n    \"transform\": {\"preset\": \"binning-1d\", \"options\": {\"bins\": 4}},\n    \"events\": [\"brushX\"],\n    \"selectFields\": [\"building_id\"]\n  }\n}\n",
