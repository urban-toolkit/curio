        "content": "import geopandas as gpd\nfrom shapely.geometry import box\n\nbuildings = gpd.GeoDataFrame(\n    {\n        \"building_id\": [1, 2, 3, 4],\n        \"height\": [12.0, 30.0, 55.0, 80.0],\n        \"area\": [400.0, 950.0, 610.0, 1200.0],\n        \"geometry\": [\n            box(-87.6360, 41.8800, -87.6350, 41.8810),\n            box(-87.6345, 41.8800, -87.6335, 41.8810),\n            box(-87.6330, 41.8800, -87.6320, 41.8810),\n            box(-87.6315, 41.8800, -87.6305, 41.8810),\n        ],\n    },\n    crs=\"EPSG:4326\",\n)\nbuildings.metadata = {\"layerType\": \"polygons\"}\nreturn buildings\n",
        "out": "DEFAULT",
        "in": "DEFAULT",
        "goal": "",
        "metadata": {"keywords": []}
      },
      {
