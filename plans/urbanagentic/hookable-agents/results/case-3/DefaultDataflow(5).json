        "content": "import pandas as pd\nimport geopandas as gpd\n\nboundaries = arg[0]\npop_data = arg[1]\n\n# Perform the merge using the correct column names from your logs\njoined_gdf = boundaries.merge(pop_data, left_on='area_numbe', right_on='community_area')\n\n# Convert back to GeoDataFrame so the next node can handle CRS\njoined_gdf = gpd.GeoDataFrame(joined_gdf, geometry='the_geom')\n\n# Fix: Ensure we use the correct column name 'total_population'\nif 'total_population' in joined_gdf.columns:\n    joined_gdf['population_density'] = joined_gdf['total_population']\nelse:\n    # Fallback to prevent the VIS_VEGA node from being empty\n    joined_gdf['population_density'] = 0\n\nreturn joined_gdf",
