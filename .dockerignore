node_modules/
**/node_modules/
npm-debug.log
dist/
__pycache__/
*.pyc
*.pyo
*.pyd
.git/
*.log

# Only exclude root .env, not nested ones (frontend needs its .env for build)
/.env
# The LLM endpoint file a deployment mounts at run time, never built in.
/.secrets/
# The weights a model package's fetch names, which download on first use:
# inside a folder directly under a package's models/, or in the folder
# docker-compose.deploy.yml mounts. Never built in.
packages/*/models/*/**
model-weights
# The folder docker-compose.bucket-mounts.yml binds into the bucket mount
# service, which mounts buckets in it: a build must never walk into a mounted
# bucket.
bucket-mounts