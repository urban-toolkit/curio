        "content": "{\n  \"$schema\": \"https://vega.github.io/schema/vega-lite/v6.json\",\n  \"description\": \"Area by ZIP. Hover a bar to highlight that ZIP on the linked map.\",\n  \"params\": [\n    {\n      \"name\": \"highlight\",\n      \"select\": {\n        \"type\": \"point\",\n        \"on\": \"pointerover\"\n      }\n    }\n  ],\n  \"mark\": \"bar\",\n  \"encoding\": {\n    \"x\": {\n      \"field\": \"zip\",\n      \"type\": \"nominal\",\n      \"sort\": \"-y\",\n      \"axis\": {\n        \"labels\": false\n      }\n    },\n    \"y\": {\n      \"field\": \"area_km2\",\n      \"type\": \"quantitative\"\n    },\n    \"color\": {\n      \"condition\": {\n        \"test\": \"datum.interacted === '1'\",\n        \"value\": \"red\"\n      },\n      \"value\": \"steelblue\"\n    }\n  }\n}",
