      {
        "id": "ea821796-827b-47ac-8104-4bfb4dc5eb63",
        "type": "curio.weather/utci-compute",
        "x": 645,
        "y": 430,
        "content": "\"\"\"UTCI from raster + weather.\n\nInput: the mean radiant temperature raster on input_0, as Milan MRT Loader\nreturns it, and the hourly weather table on input_1, as ERA5 Milan Weather\nreturns it. Returns `(grid, shape)`: the Universal Thermal Climate Index of\neach cell, as a list of rows, and the grid's `[width, height]`, which UTCI\nZonal Mean takes with the raster.\n\nThe Widgets tab sets the hour, the weather table's `it`, whose weather is\nused, and how many times its width and height the raster is read at.\n\"\"\"\n\nfrom weather_utci import utci_grid\n\nreturn utci_grid(\n    [!! input_0 !!], [!! input_1 !!],\n    timestamp=int([!! timestamp !!]),\n    upscale_factor=float([!! upscale_factor !!]),\n)\n",
        "out": "DEFAULT",
        "in": "DEFAULT",
        "goal": "",
        "metadata": {
          "keywords": [],
          "widgets": [
            {
              "name": "timestamp",
              "type": "slider",
              "label": "Hour",
              "default": 12,
              "options": {
                "min": 0,
                "max": 23,
                "step": 1
              }
            },
            {
              "name": "upscale_factor",
              "type": "number",
              "label": "Upscale factor",
              "default": 1.0
            }
          ]
        }
      },
      {
        "id": "4b7c2234-d107-4531-b890-5c582efbe444",
        "type": "curio.weather/census-load",
        "x": 0,
        "y": 860,
        "content": "return curio_load_data(\"data.utk.milan-census-gt65\")\n",
        "out": "DEFAULT",
        "in": "DEFAULT",
        "goal": "",
        "metadata": {
          "keywords": []
        }
      },
      {
        "id": "cdb373b6-1b35-47db-bfd7-fe4ae1e9efdc",
        "type": "curio.weather/utci-zonal",
        "x": 1290,
        "y": 430,
        "content": "\"\"\"UTCI Zonal Mean.\n\nInput, in order: the mean radiant temperature raster on input_0, which places\nthe grid; UTCI from raster + weather's `(grid, shape)` on input_1; the census\npolygons on input_2, with their `gt_65`. Returns the polygons' geometry, `mean`,\nthe mean UTCI over each polygon, and `gt_65`.\n\"\"\"\n\nfrom weather_census import utci_zonal_mean\n\nreturn utci_zonal_mean([!! input_0 !!], [!! input_1 !!], [!! input_2 !!])\n",
        "out": "DEFAULT",
        "in": "DEFAULT",
        "goal": "",
        "metadata": {
          "keywords": []
        }
      },
      {
        "id": "3cc268ee-ec4b-4921-ac69-6d0bb3691cb4",
        "type": "curio.weather/census-reproject",
        "x": 1935,
        "y": 430,
        "content": "\"\"\"Reproject census to EPSG:3395.\n\nInput: UTCI Zonal Mean's polygons. Returns them in the target CRS, those whose\nmean UTCI is not above 0 left out, named `census` for the views.\n\nThe Widgets tab sets the CRS the census polygons are in and the CRS the views\ndraw them in, each as its EPSG code.\n\"\"\"\n\nfrom weather_census import reproject_census\n\nreturn reproject_census(\n    input_0,\n    source_crs=int([!! source_crs !!]),\n    target_crs=int([!! target_crs !!]),\n)\n",
        "out": "DEFAULT",
        "in": "DEFAULT",
        "goal": "",
        "metadata": {
          "keywords": [],
          "widgets": [
            {
              "name": "source_crs",
              "type": "number",
              "label": "Source CRS",
              "default": 32632,
              "options": {
                "step": 1
              }
            },
            {
              "name": "target_crs",
              "type": "number",
              "label": "Target CRS",
              "default": 3395,
              "options": {
                "step": 1
              }
            }
          ]
        }
      },
      {
        "id": "35bd75ce-005e-40e1-9172-7caef9ccf046",
        "type": "curio.weather/gt65-projection",
        "x": 2580,
        "y": 0,
        "content": "\"\"\"Project gt_65 column.\n\nInput: the census polygons, as Reproject census to EPSG:3395 returns them.\nReturns their `gt_65` column alone, for a chart of the residents over 65.\n\"\"\"\n\nfrom weather_census import gt65_column\n\nreturn gt65_column(input_0)\n",
        "out": "DEFAULT",
        "in": "DEFAULT",
        "goal": "",
        "metadata": {
          "keywords": []
        }
      },
      {
        "id": "6c4aa6a8-45eb-480e-bb3d-3fd54d13325b",
        "type": "curio.builtin/autk-grammar",
        "x": 2580,
        "y": 430,
        "content": "{\r\n  \"map\": {\r\n    \"layerRefs\": [\r\n      {\r\n        \"dataRef\": \"[!! input_0 !!]\",\r\n        \"getFnv\": \"mean\",\r\n        \"getFnvType\": \"quantitative\",\r\n        \"defaultFnv\": 0,\r\n        \"isPick\": true,\r\n        \"isColorMap\": true,\r\n        \"title\": \"Mean UTCI (°C)\"\r\n      }\r\n    ]\r\n  }\r\n}",
        "out": "DEFAULT",
        "in": "DEFAULT",
        "goal": "Render Milan census polygons coloured by mean UTCI value.",
        "metadata": {
          "keywords": []
        }
      },
      {
        "id": "3334485c-50ad-4adf-9574-45f8a9704860",
        "type": "curio.builtin/vis-vega",
        "x": 2580,
        "y": 860,
        "content": "{\n \"$schema\": \"https://vega.github.io/schema/vega-lite/v6.json\",\n \"params\": [\n   {\"name\": \"clickSelect\", \"select\": \"interval\"}\n ],\n \"mark\": {\n   \"type\": \"point\",\n   \"cursor\": \"pointer\"\n },\n \"encoding\": {\n   \"x\": {\"field\": \"gt_65\", \"type\": \"quantitative\"},\n   \"y\": {\"field\": \"mean\", \"type\": \"quantitative\", \"scale\": {\"domain\": [37, 42]}},\n   \"opacity\": {\n     \"condition\": {\"param\": \"clickSelect\", \"value\": 0.7},\n     \"value\": 0.3\n   },\n   \"color\": {\n     \"condition\": [\n       {\"param\": \"clickSelect\", \"empty\": false, \"value\": \"red\"},\n       {\"test\": \"datum.interacted === '1'\", \"value\": \"red\"}\n     ],\n     \"value\": \"blue\"\n   }\n },\n \"config\": {\n   \"scale\": {\n     \"bandPaddingInner\": 0.2\n   }\n }\n}",
        "out": "DEFAULT",
        "in": "DEFAULT",
        "goal": "",
        "metadata": {
          "keywords": []
        }
      },
      {
        "id": "bcded943-0536-4d5b-adeb-e51dfc28afba",
        "type": "curio.builtin/vis-vega",
        "x": 3225,
        "y": 0,
        "content": "{\n \"$schema\": \"https://vega.github.io/schema/vega-lite/v6.json\",\n \"transform\": [\n   {\n     \"fold\": [\"gt_65\"],\n     \"as\": [\"Variable\", \"Value\"]\n   }\n ],\n \"mark\": {\n   \"type\": \"boxplot\",\n   \"size\": 60\n },\n \"encoding\": {\n   \"x\": {\"field\": \"Variable\", \"type\": \"nominal\", \"title\": \"Variable\"},\n   \"y\": {\"field\": \"Value\", \"type\": \"quantitative\", \"title\": \"Value\"}\n }\n}",
        "out": "DEFAULT",
