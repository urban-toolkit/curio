        "id": "survey-loader",
        "type": "curio.builtin/data-loading",
        "x": 0,
        "y": 430,
        "content": "collection = curio_load_collection(\"data.curio.storage-survey\")\n\nreturn collection\n",
        "out": "DEFAULT",
