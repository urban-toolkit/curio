        "y": 215,
        "content": "import pandas as pd\n\nbuildings = pd.DataFrame({\n    'building': ['Library', 'Market', 'Station', 'School', 'Tower', 'Hall'],\n    'height_m': [12.0, 18.0, 25.0, 9.0, 60.0, 30.0],\n})\nbuildings.metadata = {'name': 'Buildings'}\nreturn buildings\n",
        "out": "DEFAULT",
        "in": "DEFAULT",
        "goal": "Buildings: six buildings and their heights"
      },
      {
        "id": "a1e7c3d2-6b5f-4e8a-9c10-2f3d4e5a6b71",
        "type": "curio.builtin/computation-analysis",
        "x": 645,
        "y": 0,
        "content": "import math\n\nbuildings = [!! input_0 !!].copy()\n# The sun stands 35 degrees above the horizon, so a shadow is the height over tan(35).\nbuildings['height_m'] = buildings['height_m'] * [!! height_factor !!]\nbuildings['shadow_m'] = (buildings['height_m'] / math.tan(math.radians(35))).round(1)\nbuildings.metadata = {'name': 'Shadow lengths'}\nreturn buildings\n",
        "out": "DEFAULT",
        "in": "DEFAULT",
        "goal": "Shadow lengths: each building's shadow at the height factor",
        "metadata": {
          "widgets": [
