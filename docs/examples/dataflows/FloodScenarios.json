              "type": "choice",
              "label": "Projection period",
              "default": "2020 - 2040",
              "options": {
                "choices": [
                  "2020 - 2040",
                  "2050 - 2080",
                  "2080 - 2100"
                ],
                "display": "radio"
              }
            },
            {
              "name": "use_NBS_classes",
              "type": "checkbox-group",
              "label": "Nature-based solutions",
              "default": [
                "Bioswales/Infiltration trenches",
                "Permeable pavements",
                "Retention ponds",
                "Infiltration trench",
                "Bioswales",
                "Constructed wetlands"
              ],
