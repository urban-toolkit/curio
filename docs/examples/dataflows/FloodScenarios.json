      {
        "id": "e3f4a5b6-2c3d-4e4f-8a5b-6c7d8e9fa0b3",
        "type": "curio.builtin/data-loading",
        "x": 650,
        "y": 0,
        "content": "# The region's window of SCOUT's nature-based solutions (NbS) class raster,\n# at its own cells: the corners are the two location Parameter nodes.\ntopleft, bottomright = [!! @topleft !!], [!! @bottomright !!]\nbounds = (topleft[\"lon\"], bottomright[\"lat\"], bottomright[\"lon\"], topleft[\"lat\"])\nsrc = curio_load_data(\"data.scout.flood-nbs-classes\", bounds=bounds)\nreturn src\n",
        "out": "DEFAULT",
        "in": "DEFAULT",
        "goal": "Read the region of SCOUT's nature-based solution classes.",
        "metadata": {
          "keywords": [],
          "packageTemplateLabel": "NbS classes"
        }
      },
      {
        "id": "f4a5b6c7-3d4e-4f5a-9b6c-7d8e9fa0b1c4",
        "type": "curio.builtin/data-loading",
        "x": 650,
        "y": 450,
        "content": "# The region's window of the period's flood depth with NbS, in metres:\n# the period is the timeline Parameter node.\ntopleft, bottomright = [!! @topleft !!], [!! @bottomright !!]\nbounds = (topleft[\"lon\"], bottomright[\"lat\"], bottomright[\"lon\"], topleft[\"lat\"])\ndepths = {\n    \"2020 - 2040\": lambda: curio_load_data(\"data.scout.flood-depth-2020-2040-nbs\", bounds=bounds),\n    \"2050 - 2080\": lambda: curio_load_data(\"data.scout.flood-depth-2050-2080-nbs\", bounds=bounds),\n    \"2080 - 2100\": lambda: curio_load_data(\"data.scout.flood-depth-2080-2100-nbs\", bounds=bounds),\n}\nperiod = [!! @timeline !!]\nif period not in depths:\n    raise ValueError(f\"There is no flood projection for {period!r}. The periods: {', '.join(depths)}.\")\nsrc = depths[period]()\nreturn src\n",
        "out": "DEFAULT",
        "in": "DEFAULT",
        "goal": "Read the region's flood depth with nature-based solutions for the period.",
        "metadata": {
          "keywords": [],
          "packageTemplateLabel": "Depth with NbS"
        }
      },
      {
        "id": "a5b6c7d8-4e5f-4a6b-8c7d-8e9fa0b1c2d5",
        "type": "curio.builtin/data-loading",
        "x": 650,
        "y": 900,
        "content": "# The region's window of the period's flood depth without NbS, in metres:\n# the period is the timeline Parameter node.\ntopleft, bottomright = [!! @topleft !!], [!! @bottomright !!]\nbounds = (topleft[\"lon\"], bottomright[\"lat\"], bottomright[\"lon\"], topleft[\"lat\"])\ndepths = {\n    \"2020 - 2040\": lambda: curio_load_data(\"data.scout.flood-depth-2020-2040-no-nbs\", bounds=bounds),\n    \"2050 - 2080\": lambda: curio_load_data(\"data.scout.flood-depth-2050-2080-no-nbs\", bounds=bounds),\n    \"2080 - 2100\": lambda: curio_load_data(\"data.scout.flood-depth-2080-2100-no-nbs\", bounds=bounds),\n}\nperiod = [!! @timeline !!]\nif period not in depths:\n    raise ValueError(f\"There is no flood projection for {period!r}. The periods: {', '.join(depths)}.\")\nsrc = depths[period]()\nreturn src\n",
        "out": "DEFAULT",
        "in": "DEFAULT",
        "goal": "Read the region's flood depth without nature-based solutions for the period.",
        "metadata": {
          "keywords": [],
          "packageTemplateLabel": "Depth without NbS"
        }
      },
      {
        "id": "1b7e4c2d-9f30-4a85-b6d1-7c2e9a0f4b58",
        "type": "curio.builtin/raster-calculator",
        "x": 1300,
        "y": 0,
        "content": "# Raster Calculator: one operation over rasters on one grid, cell by cell.\n# Input 0 is SCOUT's NbS classes, input 1 the depth with NbS and input 2 the\n# depth without: a cell takes the depth with NbS where its class is one of\n# the chosen solutions, and the depth without NbS elsewhere.\nNBS_CLASSES = {\n    21: \"Bioswales/Infiltration trenches\",\n    31: \"Permeable pavements\",\n    43: \"Retention ponds\",\n    52: \"Infiltration trench\",\n    71: \"Bioswales\",\n    81: \"Bioswales\",\n    90: \"Constructed wetlands\",\n    95: \"Constructed wetlands\",\n}\nchosen = [!! use_NBS_classes !!]\ncodes = [code for code, name in NBS_CLASSES.items() if name in chosen]\nreturn curio_raster_calculate(\"choose\", arg, codes=codes)\n",
        "out": "DEFAULT",
        "in": "DEFAULT",
        "goal": "Take the flood depth with no nature-based solution in place.",
        "metadata": {
          "keywords": [],
          "widgets": [
            {
              "name": "use_NBS_classes",
              "type": "checkbox-group",
              "label": "Nature-based solutions",
              "default": [
                "Bioswales/Infiltration trenches",
                "Permeable pavements",
                "Retention ponds",
                "Infiltration trench",
