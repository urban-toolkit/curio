    "nodes": [
      {
        "id": "5d2b8e1a-4c7f-4a36-9b0e-2f6c8a1d3e57",
        "type": "curio.builtin/data-loading",
        "x": 105,
        "y": 441,
        "content": "# Downtown Chicago's roads from the Data Catalog: OpenStreetMap, the box SCOUT's\n# weather routing example routes in, as a GeoDataFrame of road lines. Weather\n# Routing reads them as its roads, and the map draws them as roads.\nroads = curio_load_data(\"data.osm.chicago-downtown-roads\")\nroads.metadata = {\"layerType\": \"roads\"}\nreturn roads\n",
        "out": "DEFAULT",
        "in": "DEFAULT",
        "goal": "Load downtown Chicago's roads from the Data Catalog.",
        "metadata": {
          "keywords": [],
          "packageTemplateLabel": "Downtown roads"
        }
      },
      {
        "id": "2e7c4a9d-6b1f-4d58-8a3e-7f0b2c5d9e61",
        "type": "scout.routing/weather-routing",
        "x": 92,
        "y": 868,
        "content": "\"\"\"Weather Routing: SCOUT's weather-aware routes over a roads layer.\n\nInput: the layers an Autark node loads from OpenStreetMap, whose roads layer,\ntable_osm_roads, the node reads as a GeoDataFrame of road lines (with highway,\nand oneway and maxspeed where known), or such a GeoDataFrame on its own. The\nroutes run inside its bounds.\nOutput: (routes, metrics).\n- routes: one row per route, a line through its nodes, with the route\n  (weight_type), route_index, distance_m in metres, duration_minutes and the\n  route's rain, heat, wind and humidity exposure. An Autark map draws it.\n- metrics: the same routes as a table: route, route_index, distance in km,\n  duration in minutes and the four exposures, for Compare Scenarios.\nThe Widgets tab sets the origin and destination, the mode, K, the start time\n(local time where the weather is, Chicago) and the rain and wind weights.\nPorted from SCOUT, https://github.com/urban-toolkit/scout.\n\"\"\"\nfrom scout_routing.weather_routing import calculate_weather_route\n\n# SCOUT's WRF forecast from the Data Catalog, one dataset of five NetCDF\n# files, a variable each.\nweather = {\n    \"RAIN\": curio_data_path(\"data.scout.chicago-weather-2025-07-06\", part=\"RAIN.nc\"),\n    \"T2\": curio_data_path(\"data.scout.chicago-weather-2025-07-06\", part=\"T2.nc\"),\n    \"WSPD10\": curio_data_path(\"data.scout.chicago-weather-2025-07-06\", part=\"WSPD10.nc\"),\n    \"WDIR10\": curio_data_path(\"data.scout.chicago-weather-2025-07-06\", part=\"WDIR10.nc\"),\n    \"RH2\": curio_data_path(\"data.scout.chicago-weather-2025-07-06\", part=\"RH2.nc\"),\n}\n\nreturn calculate_weather_route(\n    [!! input_0:table_osm_roads !!],\n    weather,\n    # SCOUT's weather graph network, the Model Catalog's weather GNN.\n    curio_load_model(\"model.scout.weather-gnn\"),\n    [!! origin !!],\n    [!! destination !!],\n    mode=[!! mode !!],\n    K=int([!! K !!]),\n    time_=[!! time !!],\n    rain=[!! rain !!],\n    wind=[!! wind !!],\n)\n",
        "out": "DEFAULT",
        "in": "DEFAULT",
        "goal": "Find SCOUT's two routes: the fastest, and the one its default weather weights favor.",
        "metadata": {
          "keywords": [],
          "widgets": [
            {
              "name": "origin",
              "type": "location",
              "label": "Origin",
              "default": {
                "lat": 41.868,
                "lon": -87.636
              },
              "value": {
                "lat": 41.896438,
                "lon": -87.659758
              }
            },
            {
              "name": "destination",
              "type": "location",
              "label": "Destination",
              "default": {
                "lat": 41.889,
                "lon": -87.624
              },
              "value": {
                "lat": 41.861649,
                "lon": -87.614034
              }
            },
            {
              "name": "mode",
              "type": "choice",
              "label": "Mode",
              "default": "Default weights",
              "options": {
                "choices": [
                  "Default weights",
                  "Custom weights",
                  "Single-factor weights"
                ],
                "display": "dropdown"
              },
              "value": "Default weights"
            },
            {
              "name": "K",
              "type": "number",
              "label": "Routes per factor (K)",
              "default": 1,
              "options": {
                "min": 1,
                "max": 3,
                "step": 1
              },
              "value": 1
            },
            {
              "name": "time",
              "type": "datetime",
              "label": "Start time (Chicago)",
              "default": "2025-07-06T12:00:00",
              "value": "2025-07-06T00:00:00"
            },
            {
              "name": "rain",
              "type": "slider",
              "label": "Rain weight",
              "default": 0.85834,
              "options": {
                "min": 0,
                "max": 1,
                "step": 1e-05
              },
              "value": 0.85834
            },
            {
              "name": "wind",
              "type": "slider",
              "label": "Wind weight",
              "default": 0.01657,
              "options": {
                "min": 0,
                "max": 1,
                "step": 1e-05
              },
              "value": 0.01657
            }
          ]
        }
      },
      {
        "id": "7b3f9d2a-5e8c-4b17-9d4a-1e6f3c8b2a05",
        "type": "curio.builtin/computation-analysis",
        "x": 739,
        "y": 145,
        "content": "# Weather Routing returns (routes, metrics): SCOUT's two routes, the fastest\n# and the one its weather weights favor. This scenario keeps one of them,\n# drawn as a 30 m band so the map can outline it.\nroutes = input_0[0]\nroute = routes[routes[\"weight_type\"] == \"fastest-route\"]\nreturn route.set_geometry(route.to_crs(3395).buffer(15).to_crs(route.crs))\n",
        "out": "DEFAULT",
        "in": "DEFAULT",
        "goal": "Take the scenario's route.",
        "metadata": {
          "keywords": [],
          "packageTemplateLabel": "Route"
        }
      },
      {
        "id": "c4a8e1f7-3d6b-4c92-b5e0-8a2d7f1c4b36",
        "type": "curio.builtin/computation-analysis",
        "x": 1400,
        "y": 420,
        "content": "# Weather Routing returns (routes, metrics): the metrics of this scenario's\n# route, its distance, duration and exposures, for Compare Scenarios.\nmetrics = input_0[1]\nreturn metrics[metrics[\"route\"] == \"fastest-route\"]\n",
        "out": "DEFAULT",
        "in": "DEFAULT",
        "goal": "Take that route's metrics.",
        "metadata": {
          "keywords": [],
          "packageTemplateLabel": "Route metrics"
