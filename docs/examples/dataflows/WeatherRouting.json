      {
        "id": "6c0e8a4d-3b9f-4d21-a7e5-9f2b6d1c8e40",
        "type": "curio.builtin/autk-grammar",
        "x": 2144,
        "y": -20,
        "content": "{\n  \"map\": {\n    \"layerRefs\": [\n      {\n        \"dataRef\": \"[!! input_0 !!]\"\n      },\n      {\n        \"dataRef\": \"[!! input_1 !!]\",\n        \"scenario\": \"fastest\"\n      },\n      {\n        \"dataRef\": \"[!! input_2 !!]\",\n        \"scenario\": \"weather-aware\"\n      }\n    ]\n  }\n}",
        "out": "DEFAULT",
        "in": "DEFAULT",
        "goal": "Draw both scenarios' routes over the roads.",
        "metadata": {
          "keywords": [],
          "packageTemplateLabel": "Routes map"
        }
