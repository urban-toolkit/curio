      {
        "id": "0fde14ff-f2f8-5510-849e-0ddfa30531f8",
        "type": "scout.raster-conversion/rasterize-buildings",
        "x": 645,
        "y": 0,
        "content": "\"\"\"Rasterize Buildings: SCOUT's building rasterizer, \"OSM vector to raster\".\n\nInput: a buildings layer, a GeoDataFrame of polygons with a CRS and a column\nof heights in metres.\nOutput: one raster in EPSG:3395, each cell a height in metres: the 256 by 256\nmap tiles SCOUT draws, 8-bit gray where 255 is the maximum height, side by\nside. A tile SCOUT writes no file for, because no building is near it, is no\ndata. An Autark map draws it as input_0, band band_1, and SCOUT's Deep Umbra\nshadow model (Accumulated Shadow) reads it.\nThe Widgets tab sets the height column, the zoom level and the maximum height.\nPorted from SCOUT, https://github.com/urban-toolkit/scout.\n\"\"\"\nfrom scout_raster_conversion.node_outputs import rasterize_buildings\n\nreturn rasterize_buildings(\n    input_0,\n    attribute=[!! attribute !!],\n    zoom=int([!! zoom !!]),\n    max_height=float([!! max_height !!]),\n    output_file=curio_output_file,\n)\n",
        "out": "DEFAULT",
        "in": "DEFAULT",
        "goal": "Rasterize the existing buildings into one zoom-16 height raster.",
        "metadata": {
          "keywords": [],
          "widgets": [
            {
              "name": "attribute",
              "type": "text",
              "label": "Height column",
              "default": "height"
            },
            {
              "name": "zoom",
              "type": "number",
              "label": "Zoom level",
              "default": 16,
              "options": {
                "min": 1,
                "max": 20,
                "step": 1
              }
            },
            {
              "name": "max_height",
              "type": "number",
              "label": "Maximum height",
              "default": 550,
              "options": {
                "min": 1,
                "step": 1,
                "units": "m"
              }
            }
          ]
        }
      },
      {
        "id": "f7786d1f-9f64-5bbe-b007-dff18db386c6",
        "type": "model.scout.deep-umbra/accumulated-shadow",
        "x": 1290,
        "y": 0,
        "content": "from deep_umbra import accumulated_shadow\nmodel = curio_load_model(\"model.scout.deep-umbra\")\nreturn accumulated_shadow(input_0, season=[!! @season !!], model=model, output_file=curio_output_file)\n",
        "out": "DEFAULT",
        "in": "DEFAULT",
        "goal": "Predict the existing buildings' accumulated shadow with Deep Umbra.",
        "metadata": {
          "keywords": []
        }
      },
      {
        "id": "74e0af5a-c06e-52ae-94ad-94acc2de1642",
        "type": "curio.builtin/raster-statistics",
        "x": 1935,
        "y": 0,
        "content": "# Raster Statistics: the mean, median, minimum, maximum and count of a\n# raster's cells, nodata left out, as a table of one row.\n# input_0 is the accumulated shadow in minutes, input_1 the heights it was\n# predicted from, as the mask: SCOUT's metrics count the ground, the cells\n# Deep Umbra reads as gray level 0, a height under 1.08 m.\nreturn curio_raster_statistics(input_0, mask=input_1, where=lambda height: height < 1.08)\n",
        "out": "DEFAULT",
        "in": "DEFAULT",
        "goal": "Take the mean and median accumulated shadow over the existing buildings' ground.",
        "metadata": {
          "keywords": []
        },
        "title": "Shadow over the ground"
      },
      {
        "id": "acfa08e6-b472-5174-9ff0-8e469d04c901",
        "type": "curio.builtin/data-transformation",
        "x": 645,
        "y": 900,
        "content": "# The 15 buildings SCOUT's high-rise shadow case removes: SCOUT's\n# B_buildings is this layer without them.\nREMOVED = [8, 10, 12, 13, 14, 18, 19, 31, 34, 51, 66, 77, 82, 106, 122]\nreturn input_0[~input_0[\"building_id\"].isin(REMOVED)].reset_index(drop=True)",
        "out": "DEFAULT",
        "in": "DEFAULT",
        "goal": "Remove the 15 buildings SCOUT's high-rise case removes.",
        "metadata": {
          "keywords": []
        },
        "title": "Remove towers"
      },
      {
        "id": "abd7fc96-4bfc-5eff-85a3-5e4991ba89b9",
        "type": "scout.raster-conversion/rasterize-buildings",
        "x": 1290,
        "y": 900,
        "content": "\"\"\"Rasterize Buildings: SCOUT's building rasterizer, \"OSM vector to raster\".\n\nInput: a buildings layer, a GeoDataFrame of polygons with a CRS and a column\nof heights in metres.\nOutput: one raster in EPSG:3395, each cell a height in metres: the 256 by 256\nmap tiles SCOUT draws, 8-bit gray where 255 is the maximum height, side by\nside. A tile SCOUT writes no file for, because no building is near it, is no\ndata. An Autark map draws it as input_0, band band_1, and SCOUT's Deep Umbra\nshadow model (Accumulated Shadow) reads it.\nThe Widgets tab sets the height column, the zoom level and the maximum height.\nPorted from SCOUT, https://github.com/urban-toolkit/scout.\n\"\"\"\nfrom scout_raster_conversion.node_outputs import rasterize_buildings\n\nreturn rasterize_buildings(\n    input_0,\n    attribute=[!! attribute !!],\n    zoom=int([!! zoom !!]),\n    max_height=float([!! max_height !!]),\n    output_file=curio_output_file,\n)\n",
        "out": "DEFAULT",
