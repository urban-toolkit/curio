      {
        "id": "32fa90a1-94a9-5a74-b768-41463f2f7078",
        "type": "curio.builtin/parameter",
        "x": 0,
        "y": 450,
        "content": "",
        "out": "DEFAULT",
        "in": "DEFAULT",
        "goal": "The season both scenarios' shadow runs in.",
        "metadata": {
          "keywords": [],
          "widgets": [
            {
              "name": "season",
