      {
        "id": "5d2b8e1a-4c7f-4a36-9b0e-2f6c8a1d3e57",
        "type": "curio.builtin/autk-grammar",
        "x": 0,
        "y": 560,
        "content": "{\n  \"data\": [\n    {\n      \"type\": \"osm\",\n      \"pbfFileUrl\": \"docs/examples/data/chicago_downtown.osm.pbf\",\n      \"queryArea\": {\n        \"bbox\": [\n          -87.662,\n          41.859,\n          -87.613,\n          41.898\n        ]\n      },\n      \"outputTableName\": \"table_osm\",\n      \"autoLoadLayers\": {\n        \"layers\": [\n          \"roads\"\n        ]\n      }\n    }\n  ]\n}",
        "out": "DEFAULT",
        "in": "DEFAULT",
        "goal": "Load the roads of SCOUT's routing box, in downtown Chicago, from OpenStreetMap.",
        "metadata": {
          "keywords": []
        }
      },
      {
        "id": "2e7c4a9d-6b1f-4d58-8a3e-7f0b2c5d9e61",
        "type": "model.scout.weather-gnn/weather-routing",
        "x": 700,
        "y": 560,
        "content": "from weather_routing import calculate_weather_route\n\n# The Data Catalog's SCOUT WRF group, a NetCDF file per variable.\nweather = {\n    \"RAIN\": curio_data_path(\"data.scout.wrf-rain\"),\n    \"T2\": curio_data_path(\"data.scout.wrf-t2\"),\n    \"WSPD10\": curio_data_path(\"data.scout.wrf-wspd10\"),\n    \"WDIR10\": curio_data_path(\"data.scout.wrf-wdir10\"),\n    \"RH2\": curio_data_path(\"data.scout.wrf-rh2\"),\n}\nmodel = curio_load_model(\"model.scout.weather-gnn\")\nreturn calculate_weather_route(\n    [!! input_0:table_osm_roads !!],\n    weather,\n    model,\n    [!! origin !!],\n    [!! destination !!],\n    mode=[!! mode !!],\n    K=int([!! K !!]),\n    time_=[!! time !!],\n    rain=[!! rain !!],\n    wind=[!! wind !!],\n)\n",
        "out": "DEFAULT",
        "in": "DEFAULT",
        "goal": "Find SCOUT's two routes: the fastest, and the one its default weather weights favor.",
        "metadata": {
          "keywords": [],
          "widgets": [
            {
              "name": "origin",
              "type": "location",
              "label": "Origin",
              "default": {
                "lat": 41.868,
                "lon": -87.636
              },
              "value": {
                "lat": 41.896438,
                "lon": -87.659758
              }
            },
            {
              "name": "destination",
              "type": "location",
              "label": "Destination",
              "default": {
                "lat": 41.889,
                "lon": -87.624
              },
              "value": {
                "lat": 41.861649,
                "lon": -87.614034
              }
            },
            {
              "name": "mode",
              "type": "choice",
              "label": "Mode",
              "default": "Default weights",
              "options": {
                "choices": [
                  "Default weights",
                  "Custom weights",
                  "Single-factor weights"
                ],
                "display": "dropdown"
              },
              "value": "Default weights"
            },
            {
              "name": "K",
              "type": "number",
              "label": "Routes per factor (K)",
              "default": 1,
              "options": {
                "min": 1,
                "max": 3,
                "step": 1
              },
              "value": 1
            },
            {
              "name": "time",
              "type": "datetime",
              "label": "Start time (Chicago)",
              "default": "2025-07-06T12:00:00",
              "value": "2025-07-05T20:00:00"
            },
            {
              "name": "rain",
              "type": "slider",
              "label": "Rain weight",
              "default": 0.85834,
              "options": {
                "min": 0,
                "max": 1,
                "step": 1e-05
              },
              "value": 0.85834
            },
            {
              "name": "wind",
              "type": "slider",
              "label": "Wind weight",
              "default": 0.01657,
              "options": {
                "min": 0,
                "max": 1,
                "step": 1e-05
              },
              "value": 0.01657
            }
          ]
        }
      },
      {
        "id": "7b3f9d2a-5e8c-4b17-9d4a-1e6f3c8b2a05",
        "type": "curio.builtin/computation-analysis",
        "x": 1400,
        "y": 0,
        "content": "# Weather Routing returns (routes, metrics): SCOUT's two routes, the fastest\n# and the one its weather weights favor. This scenario keeps one of them,\n# a line the map draws in the scenario's color.\nroutes = input_0[0]\nreturn routes[routes[\"weight_type\"] == \"fastest-route\"]\n",
        "out": "DEFAULT",
        "in": "DEFAULT",
        "goal": "Take the scenario's route.",
        "metadata": {
          "keywords": [],
          "packageTemplateLabel": "Route"
        }
      },
      {
        "id": "c4a8e1f7-3d6b-4c92-b5e0-8a2d7f1c4b36",
        "type": "curio.builtin/computation-analysis",
        "x": 1400,
        "y": 420,
        "content": "# Weather Routing returns (routes, metrics): the metrics of this scenario's\n# route, its distance, duration and exposures, which the charts draw in the\n# scenario's color.\nmetrics = input_0[1]\nreturn metrics[metrics[\"route\"] == \"fastest-route\"]\n",
        "out": "DEFAULT",
