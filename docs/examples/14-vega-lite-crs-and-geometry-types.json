      {
        "id": "d784097d-65c1-5141-aba9-3f81910da22a",
        "type": "curio.builtin/data-loading",
        "x": 0,
        "y": 645,
        "content": "import geopandas as gpd\n\ndataset_path = curio_dataset_path(\"data.urbanlab.chicago-boundary\")\ngdf = gpd.read_file(dataset_path)\n\nreturn gdf",
        "out": "DEFAULT",
        "in": "DEFAULT",
        "goal": "",
        "metadata": {
          "keywords": []
        }
      },
      {
        "id": "66e1b696-d618-5e64-bb8f-47a0654d0bdf",
        "type": "curio.builtin/data-transformation",
        "x": 645,
        "y": 0,
        "content": "gdf = arg\n\n# A bounding box per ZIP, as a second geometry column.\ngdf[\"bbox\"] = gdf.geometry.envelope\n\nreturn gdf",
        "out": "DEFAULT",
        "in": "DEFAULT",
        "goal": "",
        "metadata": {
          "keywords": []
        }
      },
      {
        "id": "6035c1d0-4b41-51b7-9f84-2063e2a8920d",
        "type": "curio.builtin/data-transformation",
        "x": 645,
        "y": 430,
        "content": "gdf = arg\n\nreturn gdf.to_crs(3395)",
        "out": "DEFAULT",
        "in": "DEFAULT",
        "goal": "",
        "metadata": {
          "keywords": []
        }
      },
      {
        "id": "6a198823-b749-5d31-8625-4b252b619956",
        "type": "curio.builtin/data-transformation",
        "x": 645,
        "y": 860,
        "content": "from shapely.geometry import (\n    GeometryCollection,\n    LineString,\n    MultiPolygon,\n    Point,\n    Polygon,\n)\n\ngdf = arg\nsquare = Polygon([(-87.8, 41.9), (-87.8, 42.0), (-87.7, 42.0), (-87.7, 41.9)])\n\nreturn gpd.GeoDataFrame(\n    {\"kind\": [\"multipolygon\", \"collection\", \"point\", \"with_z\", \"missing\", \"line\"]},\n    geometry=[\n        MultiPolygon([square, Polygon([(-87.6, 41.7), (-87.6, 41.8), (-87.5, 41.8)])]),\n        GeometryCollection([square, Point(-87.65, 41.85)]),\n        Point(-87.62, 41.88),\n        Point(-87.63, 41.89, 30.0),\n        None,\n        LineString([(-87.7, 41.8), (-87.6, 41.9)]),\n    ],\n    crs=4326,\n)",
        "out": "DEFAULT",
        "in": "DEFAULT",
        "goal": "",
        "metadata": {
          "keywords": []
        }
      },
      {
        "id": "724bff3b-a95b-54fa-9a76-009204107d9e",
        "type": "curio.builtin/data-transformation",
        "x": 645,
        "y": 1290,
        "content": "gdf = arg\n\nreturn gdf[gdf[\"zip\"] == \"00000\"]",
        "out": "DEFAULT",
        "in": "DEFAULT",
        "goal": "",
        "metadata": {
          "keywords": []
        }
      },
      {
        "id": "422e17a1-d813-52eb-9785-cc10a2540873",
        "type": "curio.builtin/data-transformation",
        "x": 1290,
        "y": 215,
        "content": "gdf = arg\n\nreturn gdf.assign(geometry=None)",
        "out": "DEFAULT",
        "in": "DEFAULT",
        "goal": "",
        "metadata": {
          "keywords": []
        }
      },
      {
        "id": "d6229bc0-e6c3-511b-9d76-f891ade9a488",
        "type": "curio.builtin/data-transformation",
        "x": 1290,
        "y": 645,
        "content": "gdf = arg\n\n# A geographic CRS that is not the usual 4326.\nreturn gdf.to_crs(4269)",
        "out": "DEFAULT",
        "in": "DEFAULT",
        "goal": "",
        "metadata": {
          "keywords": []
        }
      },
      {
