        "x": 0,
        "y": 985,
        "content": "import geopandas as gpd\nimport pandas as pd\nfrom shapely.geometry import Point\n\ndataset_path = curio_dataset_path(\"data.cityofchicago.green-roofs\")\ndf = pd.read_csv(dataset_path).dropna(subset=[\"LONGITUDE\", \"LATITUDE\"])\npoints = [Point(xy) for xy in zip(df[\"LONGITUDE\"], df[\"LATITUDE\"])]\n\nreturn gpd.GeoDataFrame(df, geometry=points, crs=4326)",
        "out": "DEFAULT",
        "in": "DEFAULT",
        "goal": "",
