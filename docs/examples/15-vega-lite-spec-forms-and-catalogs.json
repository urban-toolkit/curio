        "x": 0,
        "y": 1415,
        "content": "import geopandas as gpd\n\ndataset_path = curio_dataset_path(\"data.projectsidewalk.chicago-labels\")\ngdf = gpd.read_parquet(dataset_path)\n\nreturn gdf[[\"label_type\", \"severity\", \"geometry\"]].head(400)",
