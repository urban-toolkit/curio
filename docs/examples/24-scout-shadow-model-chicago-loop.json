{
  "dataflow": {
    "nodes": [
      {
        "id": "2ac73083-5bbd-5f6b-930f-a536392f4f33",
        "type": "curio.builtin/data-loading",
        "x": 0,
        "y": 215,
        "out": "DEFAULT",
        "in": "DEFAULT",
        "goal": "Load SCOUT's 123 Chicago Loop buildings and their heights from the Data Catalog.",
        "metadata": {
          "keywords": []
        },
        "content": "# SCOUT's Chicago Loop buildings, with their heights in metres.\ngdf = curio_load_data(\"data.scout.loop-buildings\")\n\n# Mark the frame as buildings, so an Autark map extrudes each footprint\n# to its height.\ngdf.metadata = {\"layerType\": \"buildings\"}\nreturn gdf\n"
      },
      {
        "id": "e1b607c4-51b5-5b82-bf4a-0227284def51",
        "type": "curio.builtin/autk-grammar",
        "x": 645,
        "y": 0,
        "out": "DEFAULT",
        "in": "DEFAULT",
        "goal": "Draw the buildings in 3D, coloured by height.",
        "metadata": {
          "keywords": []
        },
        "content": "{\n  \"map\": {\n    \"layerRefs\": [\n      {\n        \"dataRef\": \"[!! input_0 !!]\",\n        \"getFnv\": \"height\",\n        \"getFnvType\": \"quantitative\",\n        \"colorMapInterpolator\": \"interpolateViridis\",\n        \"title\": \"Building height (m)\"\n      }\n    ]\n  }\n}"
      },
      {
        "id": "333949c8-983a-5cdb-845b-04abe06c2dc7",
        "type": "scout.raster-conversion/rasterize-buildings",
        "x": 645,
        "y": 430,
        "out": "DEFAULT",
        "in": "DEFAULT",
        "goal": "Rasterize the buildings' heights into SCOUT's zoom-16 tiles, side by side in one raster.",
        "metadata": {
          "keywords": [],
          "widgets": [
            {
              "name": "attribute",
              "type": "text",
              "label": "Height column",
              "default": "height"
            },
            {
              "name": "zoom",
              "type": "number",
              "label": "Zoom level",
              "default": 16,
              "options": {
                "min": 1,
                "max": 20,
                "step": 1
              }
            },
            {
              "name": "max_height",
              "type": "number",
              "label": "Maximum height",
              "default": 550,
              "options": {
                "min": 1,
                "step": 1,
                "units": "m"
              }
            }
          ]
        },
        "content": "\"\"\"Rasterize Buildings: SCOUT's building rasterizer, \"OSM vector to raster\".\n\nInput: a buildings layer, a GeoDataFrame of polygons with a CRS and a column\nof heights in metres.\nOutput: one raster in EPSG:3395, each cell a height in metres: the 256 by 256\nmap tiles SCOUT draws, 8-bit gray where 255 is the maximum height, side by\nside. A tile SCOUT writes no file for, because no building is near it, is no\ndata. An Autark map draws it as input_0, band band_1, and SCOUT's Deep Umbra\nshadow model (Accumulated Shadow) reads it.\nThe Widgets tab sets the height column, the zoom level and the maximum height.\nPorted from SCOUT, https://github.com/urban-toolkit/scout.\n\"\"\"\nfrom scout_raster_conversion.node_outputs import rasterize_buildings\n\nreturn rasterize_buildings(\n    input_0,\n    attribute=[!! attribute !!],\n    zoom=int([!! zoom !!]),\n    max_height=float([!! max_height !!]),\n    output_file=curio_output_file,\n)\n"
      },
      {
        "id": "ebac4811-abcc-50fe-a61a-cc9c9ac8c011",
        "type": "curio.builtin/autk-grammar",
        "x": 1290,
        "y": 215,
        "out": "DEFAULT",
        "in": "DEFAULT",
        "goal": "Draw the mosaic of building heights on a map.",
        "metadata": {
          "keywords": []
        },
        "content": "{\n  \"map\": {\n    \"layerRefs\": [\n      {\n        \"dataRef\": \"[!! input_0 !!]\",\n        \"getFnv\": \"band_1\",\n        \"colorMapInterpolator\": \"interpolateViridis\",\n        \"isColorMap\": false,\n        \"transferFunction\": {\n          \"mode\": \"far-zero\",\n          \"opacityMin\": 0,\n          \"opacityMax\": 1,\n          \"gamma\": 0.0001\n        }\n      }\n    ]\n  }\n}"
      },
      {
        "id": "45abcfa2-7705-50d4-adf2-db8f556a59c6",
        "type": "model.scout.deep-umbra/accumulated-shadow",
        "x": 1290,
        "y": 645,
        "out": "DEFAULT",
        "in": "DEFAULT",
        "goal": "Predict how many minutes of a summer day the ground around the buildings is in shadow, with SCOUT's Deep Umbra model.",
        "metadata": {
          "keywords": [],
          "widgets": [
            {
              "name": "season",
              "type": "choice",
              "label": "Season",
              "default": "summer",
              "options": {
                "choices": [
                  "spring",
                  "summer",
                  "winter"
                ],
                "display": "radio"
              }
            }
          ]
        },
        "content": "from deep_umbra import accumulated_shadow\nmodel = curio_load_model(\"model.scout.deep-umbra\")\nreturn accumulated_shadow(input_0, season=[!! season !!], model=model, output_file=curio_output_file)\n"
      },
      {
        "id": "8a914e39-4cb1-535d-9a8b-19b45f6be288",
        "type": "curio.builtin/raster-calculator",
        "x": 1935,
        "y": 430,
        "out": "DEFAULT",
        "in": "DEFAULT",
        "goal": "Take the mean and median accumulated shadow over the ground.",
        "metadata": {
          "keywords": []
        },
        "content": "# Statistics: the mean, median, minimum, maximum and count of a\n# raster's cells, nodata left out, as a table of one row.\n# input_0 is the accumulated shadow in minutes, input_1 the heights it was\n# predicted from, as the mask: SCOUT's metrics count the ground, the cells\n# Deep Umbra reads as gray level 0, a height under 1.08 m.\nreturn curio_raster_statistics(input_0, mask=input_1, where=lambda height: height < 1.08)\n"
      },
      {
        "id": "6cef8611-e3ec-52d4-9caf-aa5d6cff3d6a",
        "type": "curio.builtin/autk-grammar",
        "x": 1935,
        "y": 860,
        "out": "DEFAULT",
        "in": "DEFAULT",
        "goal": "Draw the minutes of shadow on a map.",
        "metadata": {
          "keywords": []
        },
        "content": "{\n  \"map\": {\n    \"layerRefs\": [\n      {\n        \"dataRef\": \"[!! input_0 !!]\",\n        \"getFnv\": \"band_1\",\n        \"colorMapInterpolator\": \"interpolateReds\",\n        \"title\": \"Accumulated shadow (minutes)\"\n      }\n    ]\n  }\n}"
      }
    ],
