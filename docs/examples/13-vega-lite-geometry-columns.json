{
  "dataflow": {
    "description": "Which column holds the geometry, and what happens when the answer is not obvious.",
    "nodes": [
      {
        "id": "2c42d7df-05e4-53b8-a0e0-120ec24d6523",
        "type": "curio.builtin/data-loading",
        "x": 0,
        "y": 1290,
        "content": "import geopandas as gpd\n\ndataset_path = curio_dataset_path(\"data.urbanlab.chicago-boundary\")\ngdf = gpd.read_file(dataset_path)\n\nreturn gdf",
        "out": "DEFAULT",
        "in": "DEFAULT",
        "goal": "",
        "metadata": {
          "keywords": []
        }
      },
      {
        "id": "8684c447-dc45-58cb-93e2-9afb41747974",
        "type": "curio.builtin/data-transformation",
        "x": 645,
        "y": 215,
        "content": "gdf = arg\n\n# The active geometry is now called `geom`, and a plain string column takes the\n# name `geometry`. Neither may shadow the other.\ngdf = gdf.rename_geometry(\"geom\")\ngdf[\"geometry\"] = gdf[\"zip\"]\n\nreturn gdf",
        "out": "DEFAULT",
        "in": "DEFAULT",
        "goal": "",
        "metadata": {
          "keywords": []
        }
      },
      {
        "id": "522aaddb-4953-563d-a275-05b14dfe7931",
        "type": "curio.builtin/data-transformation",
        "x": 645,
        "y": 645,
        "content": "gdf = arg\n\nreturn pd.DataFrame(gdf.drop(columns=gdf.geometry.name))",
        "out": "DEFAULT",
        "in": "DEFAULT",
        "goal": "",
        "metadata": {
          "keywords": []
        }
      },
      {
        "id": "2520e247-f777-5b4b-97fb-a283d6cbc128",
        "type": "curio.builtin/data-transformation",
        "x": 645,
        "y": 1075,
        "content": "gdf = arg\n\n# `pd.DataFrame(gdf)` keeps the shapely objects but loses the GeoDataFrame type,\n# so nothing declares which column is geometry.\nreturn pd.DataFrame(gdf)",
        "out": "DEFAULT",
        "in": "DEFAULT",
        "goal": "",
        "metadata": {
          "keywords": []
        }
      },
      {
        "id": "b068e075-a841-5331-bb46-55663a18d6b3",
        "type": "curio.builtin/data-transformation",
        "x": 645,
        "y": 1505,
        "content": "gdf = arg\n\n# A plain DataFrame with two shapely columns: no active geometry, so there is no\n# single right answer about which one to draw.\nflat = pd.DataFrame(gdf.drop(columns=gdf.geometry.name))\nflat[\"centroid\"] = gdf.to_crs(3395).geometry.centroid.to_crs(4326)\nflat[\"bbox\"] = gdf.geometry.envelope\n\nreturn flat",
        "out": "DEFAULT",
        "in": "DEFAULT",
        "goal": "",
        "metadata": {
          "keywords": []
        }
      },
      {
        "id": "5aa9cce4-5834-546c-8351-643265c56b97",
        "type": "curio.builtin/data-transformation",
        "x": 645,
        "y": 1935,
        "content": "gdf = arg\n\ngdf[\"centroid\"] = gdf.to_crs(3395).geometry.centroid.to_crs(4326)\ngdf[\"bbox\"] = gdf.geometry.envelope\n\nreturn gdf",
        "out": "DEFAULT",
        "in": "DEFAULT",
        "goal": "",
        "metadata": {
          "keywords": []
        }
      },
      {
        "id": "d4d6adb0-9f36-57bf-bc2e-e1261fed7c08",
        "type": "curio.builtin/data-transformation",
        "x": 645,
        "y": 2365,
        "content": "gdf = arg\n\ncentroids = gdf.to_crs(3395).geometry.centroid.to_crs(4326)\ngdf[\"centroid\"] = centroids.where(gdf.index % 2 == 0, None)\n\nreturn gdf",
        "out": "DEFAULT",
        "in": "DEFAULT",
        "goal": "",
        "metadata": {
          "keywords": []
        }
      },
      {
